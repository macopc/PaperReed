+import { AccountStore, DatabaseStore, DraftStore, Message } from 'mailspring-exports';
+import type { DraftEditingSession } from 'mailspring-exports';
+import { isMessageAllowed, isMessageVisible, mcpGrant } from './mcp-access-control';
+
 const installer = require('../bin/install.cjs');
 export function cliPaths() {
   return installer.paths({
@@ -32,3 +36,24 @@ export function agentHandoff(context: Record<string, unknown>) {
   if (!cliStatus().ready) throw new Error('请先在 Agent 设置中安装 CLI 或更新连接。');
   return installer.handoff(cliPaths(), context);
 }
+
+export async function prepareDraftHandoff(session: DraftEditingSession) {
+  const draft = session.draft();
+  if (!draft) return null;
+  const { id, accountId, headerMessageId, version } = draft;
+  const grant = JSON.stringify(mcpGrant());
+  const isCurrent = () => {
+    const current = session.draft();
+    return current?.id === id && current.accountId === accountId &&
+      current.headerMessageId === headerMessageId && current.version === version &&
+      AccountStore.accountIds().includes(accountId) && AppEnv.config.get('core.mcp.enabled') &&
+      JSON.stringify(mcpGrant()) === grant && isMessageAllowed(current) &&
+      DraftStore.cachedDraftSession(headerMessageId, accountId) === session &&
+      !DraftStore.isSendingDraft(headerMessageId, accountId) &&
+      !DraftStore.hasUnsavedDraftWork(headerMessageId, accountId);
+  };
+  if (!isCurrent() || !(await isMessageVisible(draft))) return null;
+  const persisted = await DatabaseStore.findBy<Message>(Message, { id, accountId, headerMessageId, draft: true });
+  if (!persisted || persisted.version !== version || !isCurrent()) return null;
+  return { context: { scope: 'draft', accountId, draftId: headerMessageId, revision: version }, isCurrent };
+}
