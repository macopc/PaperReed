+
+function rpcResult(body, contentType, id) {
+  // The desktop's POST response ends after sending its matching JSON-RPC reply.
+  const frames = contentType?.startsWith('text/event-stream')
+    ? body.split(/\r?\n\r?\n|\r\r/).map((event) =>
+        event.split(/\r?\n|\r/).filter((line) => line.startsWith('data:'))
+          .map((line) => line.slice(5).replace(/^ /, '')).join('\n')
+      ).filter(Boolean)
+    : [body];
+  for (const frame of frames) {
+    let decoded;
+    try {
+      decoded = JSON.parse(frame);
+    } catch {
+      throw invalidResponse();
+    }
+    for (const reply of Array.isArray(decoded) ? decoded : [decoded]) {
+      if (reply?.jsonrpc !== '2.0' || reply.id !== id) continue;
+      if (reply.error) throw new Error(reply.error.message || 'MCP request failed.');
+      if (reply.result && typeof reply.result === 'object') return reply.result;
+    }
+  }
+  throw invalidResponse();
+}
+
+async function callDesktopTool(endpoint, token, command, input) {
+  const attachment = command === 'attachment-get';
+  const http = require('node:http');
+  const agent = new http.Agent({ keepAlive: true, maxSockets: 1 });
+  const deadline = AbortSignal.timeout(attachment ? 45000 : 15000);
+  const headers = {
+    Authorization: `Bearer ${token}`,
+    Accept: 'application/json, text/event-stream',
+  };
+
+  function request(method, message, timeout = 10000) {
+    const body = message && JSON.stringify({ jsonrpc: '2.0', ...message });
+    const requestHeaders = body
+      ? { ...headers, 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(body) }
+      : headers;
+    return new Promise((resolve, reject) => {
+      // Never follow redirects or replay tool requests.
+      const req = http.request(endpoint, {
+        agent, method, headers: requestHeaders,
+        signal: AbortSignal.any([deadline, AbortSignal.timeout(timeout)]),
+      }, (res) => {
+        res.setEncoding('utf8');
+        let text = '';
+        res.on('data', (chunk) => { text += chunk; });
+        res.on('error', reject);
+        res.on('end', () => {
+          if (res.statusCode < 200 || res.statusCode >= 300) {
+            let detail;
+            try { detail = JSON.parse(text)?.error?.message; } catch {}
+            reject(new Error(`MCP HTTP ${res.statusCode}${detail ? `: ${detail}` : ''}`));
+          } else {
+            resolve({ body: text, headers: res.headers });
+          }
+        });
+      });
+      req.on('error', reject);
+      req.end(body);
+    });
+  }
+
+  try {
+    const initialized = await request('POST', {
+      id: 0,
+      method: 'initialize',
+      params: {
+        protocolVersion: protocolVersions[0],
+        capabilities: {},
+        clientInfo: { name: 'paper-reed-cli', version: VERSION },
+      },
+    });
+    const session = initialized.headers['mcp-session-id'];
+    if (session) headers['Mcp-Session-Id'] = session;
+    const { protocolVersion } = rpcResult(initialized.body, initialized.headers['content-type'], 0);
+    if (!protocolVersions.includes(protocolVersion)) throw invalidResponse();
+    headers['MCP-Protocol-Version'] = protocolVersion;
+    await request('POST', { method: 'notifications/initialized' });
+    const reply = await request('POST', {
+      id: 1,
+      method: 'tools/call',
+      params: { name: command === 'doctor' ? 'list_accounts' : commands[command][0], arguments: input },
+    }, attachment ? 40000 : 10000);
+    printToolResult(command, endpoint, rpcResult(reply.body, reply.headers['content-type'], 1));
+  } finally {
+    // Release a stateful session without masking the original result.
+    try {
+      if (headers['Mcp-Session-Id']) await request('DELETE', undefined, 1000);
+    } catch {} finally {
+      agent.destroy();
+    }
+  }
+}
+
+function printToolResult(command, endpoint, result) {
+  const item = Array.isArray(result.content) && result.content.find((c) => c?.type === 'text');
+  if (!item || typeof item.text !== 'string') throw invalidResponse();
+  let output;
+  try {
+    output = JSON.parse(item.text);
+  } catch {
+    if (!result.isError)
+      throw fail(
+        'invalid-response',
+        'Invalid JSON response.',
+        'Update Paper Reed and its CLI together.'
+      );
+    output = { error: item.text };
+  }
+  if (result.isError) {
+    process.stdout.write(JSON.stringify(output) + '\n');
+    process.exitCode = 1;
+    return;
+  }
+  if (
+    output?.items?.some((item) =>
+      ['rejected', 'failed'].includes(item.status)
+    )
+  )
+    process.exitCode = 1;
+  if (command === 'doctor')
+    output = {
+      ok: true,
+      version: VERSION,
+      endpoint: endpoint.href,
+      authorizedAccounts: output.length,
+      next: output.length
+        ? 'Run paper-reed accounts.'
+        : 'Allow an account in Paper Reed → Settings → Agent.',
+    };
+  process.stdout.write(JSON.stringify(output) + '\n');
 }
