+    void recordDraftRecovery(const std::string & account, const std::string & copy,
+                             const json & origin, bool existing) {
+        if (existing || !origin.is_object() || !origin.count("sourceDraftId") ||
+            !origin["sourceDraftId"].is_string() || origin["sourceDraftId"].get<std::string>().empty() ||
+            origin["sourceDraftId"] == copy || !origin.count("sourceRevision") ||
+            !origin["sourceRevision"].is_number_integer() || origin["sourceRevision"].get<int>() < 1) {
+            throw Conflict("invalid-recovery-source", "Recovery provenance requires a new copy and a saved source revision.");
+        }
+        auto now = std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::system_clock::now().time_since_epoch()).count();
+        SQLite::Statement next(db, "SELECT COALESCE(MAX(copyNumber), 0) + 1 FROM PaperReedDraftRecovery WHERE accountId = ? AND sourceDraftId = ?");
+        next.bind(1, account); next.bind(2, origin["sourceDraftId"].get<std::string>()); next.executeStep();
+        int number = next.getColumn(0).getInt();
+        SQLite::Statement q(db, "INSERT INTO PaperReedDraftRecovery "
+            "(accountId, copyDraftId, sourceDraftId, sourceRevision, createdAt, copyNumber) VALUES (?, ?, ?, ?, ?, ?)");
+        q.bind(1, account); q.bind(2, copy); q.bind(3, origin["sourceDraftId"].get<std::string>());
+        q.bind(4, origin["sourceRevision"].get<int>()); q.bind(5, static_cast<int64_t>(now)); q.bind(6, number); q.exec();
+    }
