@@ -0,0 +1,31 @@
+import React from 'react';
+import { Account } from 'mailspring-exports';
+import OAuthSignInPage from './oauth-signin-page';
+import AccountProviders from './account-providers';
+import * as OnboardingActions from './onboarding-actions';
+import { buildMicrosoftAccountFromAuthResponse, buildO365AuthURL, microsoftClientId } from './onboarding-helpers';
+
+// Reuse the upstream browser/PKCE flow and native Graph transport. The application
+// registration is configured by the distributor, never borrowed from upstream.
+export default class PaperReedMicrosoftPage extends React.Component<{ account: Account }> {
+  authURL = microsoftClientId() ? buildO365AuthURL() : null;
+
+  render() {
+    if (!this.authURL) return <div className="page account-choose">
+      <h2>Microsoft 登录尚未配置</h2>
+      <p>此开发构建需要由维护者配置 Paper Reed 的 Microsoft 应用。</p>
+      <p>配置完成后，可直接使用 Outlook、Hotmail 或 Microsoft 365 账号登录。</p>
+      <button className="btn" onClick={() => OnboardingActions.moveToPreviousPage()}>返回邮箱选择</button>
+    </div>;
+    return <OAuthSignInPage
+      serviceName="Microsoft" providerAuthPageUrl={this.authURL}
+      providerConfig={AccountProviders.find(p => p.provider === 'office365')}
+      buildAccountFromAuthResponse={code => buildMicrosoftAccountFromAuthResponse(
+        code, this.props.account.provider === 'outlook' ? 'outlook' : 'office365',
+        { withGraphSend: true, expectedEmail: this.props.account.emailAddress || undefined }
+      )}
+      onSuccess={account => OnboardingActions.finishAndAddAccount(account)}
+      onTryAgain={() => OnboardingActions.moveToPreviousPage()}
+    />;
+  }
+}
