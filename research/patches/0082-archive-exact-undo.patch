+static void _settleRecoveredMoveSources(MailStore * store, Task * task, const vector<json> & laterMoves,
+    const map<string, vector<TaskPlacement *>> & itemsByMessage) {
+    for (const auto & move : laterMoves) {
+        if (!move.contains("recoveredMoveCopies")) continue;
+        auto plans = move["recoveredMoveCopies"];
+        auto markers = move.value("queuedMoveCopies", json::object());
+        bool changed = false;
+        for (auto & plan : plans.items()) {
+            const auto items = itemsByMessage.find(plan.key());
+            if (items == itemsByMessage.end()) continue;
+            const auto rows = store->placementsForMessage(plan.key());
+            for (auto & proof : plan.value()["copies"]) {
+                if (!proof.contains("sourceTaskId")) continue;
+                const bool direct = proof["sourceTaskId"] == task->id();
+                auto item = std::find_if(items->second.begin(), items->second.end(), [&](const TaskPlacement * candidate) {
+                    return candidate->moved && candidate->movedUIDValidity &&
+                        candidate->placement.rowid == proof["rowId"] && (!direct || candidate->destFolderId == proof["sourceId"]);
