diff --git a/app/internal_packages/paper-reed/lib/draft-status.tsx b/app/internal_packages/paper-reed/lib/draft-status.tsx
new file mode 100644
index 0000000..5684011
--- /dev/null
+++ b/app/internal_packages/paper-reed/lib/draft-status.tsx
@@ -0,0 +1,69 @@
+import React from 'react';
+import { Actions, DraftEditingSession, Message } from 'mailspring-exports';
+import { saveDraftCopy, desktopAccess } from '../../../src/services/mail-core';
+
+export default class PaperReedDraftStatus extends React.Component<{ session: DraftEditingSession }> {
+  state = { busy: false, copyId: '', copySnapshot: '', notice: '' };
+  mounted = false;
+  componentDidMount() {
+    this.mounted = true;
+    this.props.session.changes.on('state', this.changed);
+  }
+  componentWillUnmount() {
+    this.mounted = false;
+    this.props.session.changes.removeListener('state', this.changed);
+  }
+  changed = () => this.forceUpdate();
+  save = async () => {
+    try { await this.props.session.changes.commit(); } catch { /* State stays visible below. */ }
+  };
+  copy = async () => {
+    if (this.state.busy) return;
+    const snapshot = JSON.stringify(this.props.session.draft().toJSON());
+    if (snapshot === this.state.copySnapshot) {
+      Actions.composePopoutDraft(this.state.copyId);
+      return;
+    }
+    this.setState({ busy: true, notice: '' });
+    try {
+      const source = new Message({}).fromJSON(JSON.parse(snapshot));
+      const copy = await saveDraftCopy(source, desktopAccess);
+      if (this.mounted) this.setState({ copyId: copy.headerMessageId, copySnapshot: snapshot,
+        notice: '副本已保存到本机。原草稿和这里的编辑仍保留。' });
+    } catch (error) {
+      if (this.mounted) this.setState({ notice: this.props.session.draft().files.length
+        ? '含附件的副本暂未支持。请保留此窗口，附件和编辑都还在。'
+        : '副本尚未保存，请重试。你的编辑仍保留在这里。' });
+    } finally {
+      if (this.mounted) this.setState({ busy: false });
+    }
+  };
+  reload = async () => {
+    this.setState({ busy: true });
+    try {
+      await this.props.session.reloadAfterCopy(this.state.copySnapshot);
+      if (this.mounted) this.setState({ notice: '已载入原草稿的最新版本，你的编辑已保存在副本中。' });
+    } catch {
+      if (this.mounted) this.setState({ notice: '尚未切换版本。请先为最新编辑另存副本，再重试。' });
+    } finally {
+      if (this.mounted) this.setState({ busy: false });
+    }
+  };
+  render() {
+    const { changes } = this.props.session;
+    const conflict = changes.saveError?.message === 'draft-conflict';
+    const label = changes.saving ? '正在保存…' : conflict ? '草稿有更新'
+      : changes.saveError ? '尚未保存，请重试' : changes.isDirty() ? '尚未保存' : '已保存到本机';
+    const currentCopy = this.state.copyId && this.state.copySnapshot === JSON.stringify(this.props.session.draft().toJSON());
+    return <div className={`pr-draft-status ${changes.saveError ? 'needs-attention' : ''}`}>
+      <div className="pr-status-line"><span role="status" aria-live="polite">{label}</span>
+        {conflict ? <button type="button" disabled={this.state.busy || changes.saving} onClick={this.copy}>
+          {this.state.busy ? '正在保存副本…' : currentCopy ? '打开副本' : '另存副本'}
+        </button> : changes.isDirty() && <button type="button" onClick={this.save} disabled={changes.saving}>立即保存</button>}
+      </div>
+      {conflict && currentCopy && <button type="button" className="pr-reload-original" onClick={this.reload} disabled={this.state.busy}>保留副本，载入最新原稿</button>}
+      {conflict && <p>其他窗口或 Agent 更新了这封草稿。你的编辑仍保留在这里。</p>}
+      {this.state.notice && <p role="status">{this.state.notice}{this.state.copyId && !currentCopy && changes.isDirty() ? ' 此后你又修改了内容，可以再存一份。' : ''}</p>}
+    </div>;
+  }
+}
diff --git a/app/internal_packages/paper-reed/lib/main.tsx b/app/internal_packages/paper-reed/lib/main.tsx
new file mode 100644
index 0000000..23e31fc
--- /dev/null
+++ b/app/internal_packages/paper-reed/lib/main.tsx
@@ -0,0 +1,11 @@
+import { ComponentRegistry, WorkspaceStore } from 'mailspring-exports';
+import PaperReedWorkspace from './workspace';
+export function activate() {
+  if (!AppEnv.config.get('core.paperReed.enabled')) return;
+  document.body.classList.add('paper-reed-enabled');
+  if (AppEnv.isMainWindow()) ComponentRegistry.register(PaperReedWorkspace, { location: WorkspaceStore.Location.PaperReed });
+}
+export function deactivate() {
+  ComponentRegistry.unregister(PaperReedWorkspace);
+  document.body.classList.remove('paper-reed-enabled');
+}
diff --git a/app/internal_packages/paper-reed/lib/workspace.tsx b/app/internal_packages/paper-reed/lib/workspace.tsx
new file mode 100644
index 0000000..d040f1b
--- /dev/null
+++ b/app/internal_packages/paper-reed/lib/workspace.tsx
@@ -0,0 +1,201 @@
+import React from 'react';
+import { clipboard } from '@electron/remote';
+import { AccountStore, Actions, CategoryStore, DatabaseStore, DraftStore, Message, Thread,
+  MailboxPerspective, WorkspaceStore } from 'mailspring-exports';
+import MessageList from '../../message-list/lib/message-list';
+import ComposerView from '../../composer/lib/composer-view';
+import InflatesDraftClientId from '../../../src/decorators/inflates-draft-client-id';
+import DraftFactory from '../../../src/flux/stores/draft-factory';
+
+const Composer = InflatesDraftClientId(ComposerView);
+const folders = [['inbox', '收件箱'], ['drafts', '草稿'], ['sent', '已发送'], ['spam', '垃圾邮件'], ['trash', '废纸篓']];
+const sendLabel = (op: { phase: string; sentCopy: string }) => op.phase === 'accepted' ? `服务器已接受 · ${op.sentCopy === 'filed' ? '副本已归档' : '副本尚未归档'}` : op.phase === 'unknown' ? '发送结果待确认，请检查邮箱，勿重复发送' : op.phase === 'rejected' ? '未发送，请检查草稿' : '正在发送';
+const colors = ['#688177', '#a18265', '#78849a', '#957789'];
+
+interface State {
+  folder: string; accountId: string; route: 'list' | 'thread' | 'compose';
+  rows: (Thread | Message)[]; selected: Thread | Message | null;
+  snippets: Record<string, string>; loading: boolean; limit: number; more: boolean; notice: string; agent: boolean;
+  copied: boolean; operations: { accountId: string; requestId: string; phase: string; sentCopy: string; subject: string }[];
+}
+let lastLocation: Pick<State, 'folder' | 'accountId' | 'route' | 'selected'> | undefined;
+
+export default class PaperReedWorkspace extends React.Component<Record<string, never>, State> {
+  static displayName = 'PaperReedWorkspace';
+  static containerStyles = { minWidth: 700, flex: 1 };
+  state: State = { folder: 'inbox', accountId: '', route: 'list', rows: [], selected: null,
+    snippets: {}, loading: true, limit: 50, more: false, notice: '', agent: false, copied: false, operations: [], ...lastLocation };
+  unlisten: (() => void)[] = [];
+  generation = 0;
+  mounted = false;
+  refreshTimer: ReturnType<typeof setTimeout>;
+  operationTimer: ReturnType<typeof setInterval>;
+  moving = false;
+  componentDidMount() {
+    this.mounted = true;
+    this.unlisten = [DatabaseStore.listen(this.scheduleRefresh), CategoryStore.listen(this.scheduleRefresh),
+      AccountStore.listen(this.scheduleRefresh), WorkspaceStore.setSectionLeaveGuard(() => {
+        if (!this.dirtySessions().length) return true;
+        this.setState({ notice: '请先保存当前编辑，再离开邮件。' });
+        return false;
+      })];
+    this.unlisten.push(DraftStore.listen(() => this.forceUpdate()));
+    this.unlisten.push(Actions.draftDeliverySucceeded.listen(({ headerMessageId }) => {
+      if (this.state.route === 'compose' && this.state.selected instanceof Message && this.state.selected.headerMessageId === headerMessageId) {
+        this.setState({ route: 'list', folder: 'sent', selected: null, rows: [], loading: true }, this.refresh);
+      }
+      this.refreshOperations();
+    }));
+    this.refresh();
+    this.operationTimer = setInterval(this.refreshOperations, 2000);
+    this.refreshOperations();
+  }
+  componentWillUnmount() {
+    const { folder, accountId, route, selected } = this.state;
+    lastLocation = { folder, accountId, route, selected };
+    this.mounted = false; this.generation++;
+    this.unlisten.forEach(fn => fn());
+    clearTimeout(this.refreshTimer); clearInterval(this.operationTimer);
+  }
+  accountIds = () => this.state.accountId ? [this.state.accountId] : AccountStore.accountIds();
+  dirtySessions = () => Object.values(DraftStore._draftSessions).filter(s => !s._destroyed && s.changes.isDirty());
+  scheduleRefresh = () => {
+    clearTimeout(this.refreshTimer);
+    this.refreshTimer = setTimeout(this.refresh, 100);
+  };
+  refresh = async () => {
+    const generation = ++this.generation;
+    const { folder, limit } = this.state;
+    const ids = this.accountIds();
+    try {
+      let rows: (Thread | Message)[] = [];
+      if (folder === 'drafts') {
+        rows = await DatabaseStore.findAll<Message>(Message).where({ draft: true })
+          .where(Message.attributes.accountId.in(ids)).order(Message.attributes.date.descending()).limit(limit + 1);
+      } else {
+        const categories = CategoryStore.getCategoriesWithRoles(ids, folder);
+        if (categories.length) rows = await DatabaseStore.findAll<Thread>(Thread)
+          .where(Thread.attributes.categories.containsAny(categories.map(c => c.id)))
+          .order((folder === 'sent' ? Thread.attributes.lastMessageSentTimestamp : Thread.attributes.lastMessageReceivedTimestamp).descending())
+          .distinct().limit(limit + 1);
+      }
+      const snippets: Record<string, string> = {};
+      if (folder !== 'drafts') await Promise.all(rows.slice(0, limit).map(async row => {
+        const messages = await DatabaseStore.findAll<Message>(Message).where({ threadId: row.id, draft: false })
+          .order(Message.attributes.date.descending()).limit(1);
+        snippets[row.id] = messages[0]?.snippet || '';
+      }));
+      if (this.mounted && generation === this.generation) this.setState({ rows: rows.slice(0, limit), snippets, more: rows.length > limit, loading: false });
+    } catch {
+      if (this.mounted && generation === this.generation) this.setState({ loading: false, notice: '邮件暂时无法读取，请重试。' });
+    }
+  };
+  refreshOperations = async () => {
+    try {
+      const rows = await DatabaseStore._query('SELECT accountId, requestId, phase, sentCopy, payload FROM PaperReedSend ORDER BY rowid DESC LIMIT 10');
+      const ids = this.accountIds();
+      if (this.mounted) this.setState({ operations: rows.filter(r => ids.includes(r.accountId)).map(r => ({
+        accountId: r.accountId, requestId: r.requestId, phase: r.phase, sentCopy: r.sentCopy,
+        subject: JSON.parse(r.payload).draft.subject || '无主题',
+      })) });
+    } catch { /* Ledger may not yet exist before the engine opens the fixture. */ }
+  };
+  move = async (next: () => void | Promise<void>) => {
+    if (this.moving) return;
+    this.moving = true;
+    try {
+      for (const session of this.dirtySessions()) await session.changes.commit();
+      if (this.dirtySessions().length) {
+        this.setState({ notice: '保存期间又有新编辑，请完成编辑后再切换。' });
+        return;
+      }
+      this.setState({ notice: '', agent: false, copied: false });
+      await next();
+    } catch (error) {
+      console.error('Paper Reed action failed', error);
+      this.setState({ notice: '当前编辑尚未保存。请在编辑区处理后再切换。' });
+    } finally { this.moving = false; }
+  };
+  navigate = (folder: string, accountId = this.state.accountId) => this.move(() => {
+    Actions.setFocus({ collection: 'thread', item: null });
+    this.setState({ folder, accountId, route: 'list', selected: null, rows: [], loading: true, limit: 50 }, this.refresh);
+  });
+  open = (row: Thread | Message) => this.move(() => {
+    if (row instanceof Message) this.setState({ route: 'compose', selected: row });
+    else {
+      Actions.focusMailboxPerspective(MailboxPerspective.forStandardCategories(this.accountIds(), this.state.folder));
+      Actions.setFocus({ collection: 'thread', item: row });
+      this.setState({ route: 'thread', selected: row });
+    }
+  });
+  compose = () => this.move(async () => {
+    const account = AccountStore.accountForId(this.state.accountId) || AccountStore.accounts()[0];
+    if (!account) { this.setState({ notice: '请先在设置中连接邮箱。' }); return; }
+    const draft = await DraftFactory.createDraft({ accountId: account.id, from: [account.defaultMe()] });
+    await DraftStore._finalizeAndPersistNewMessage(draft);
+    this.setState({ route: 'compose', selected: draft });
+  });
+  copyContext = () => this.move(async () => {
+    const { selected, route, folder } = this.state;
+    let context: Record<string, unknown> = { scope: 'mailbox', accountIds: this.accountIds(), mailbox: folder };
+    if (route === 'compose' && selected instanceof Message) {
+      const session = await DraftStore.sessionForClientId(selected.headerMessageId);
+      context = { scope: 'draft', accountId: session.draft().accountId, draftId: session.headerMessageId, revision: session.draft().version };
+    } else if (route === 'thread' && selected) context = { scope: 'thread', accountId: selected.accountId, threadId: selected.id };
+    await clipboard.writeText(JSON.stringify({ product: 'Paper Reed', task: '请先阅读这份上下文。发送邮件前请向我确认。', context }, null, 2));
+    this.setState({ agent: true, copied: true });
+  });
+  preferences = () => this.move(() => { Actions.openPreferences(); });
+  agentPreferences = () => this.move(() => { Actions.switchPreferencesTab('MCP'); Actions.openPreferences(); });
+  renderRow = (row: Thread | Message) => {
+    const draft = row instanceof Message;
+    const contacts = draft ? row.to : row.participants;
+    const person = contacts?.find(c => c.email !== AccountStore.accountForId(row.accountId)?.emailAddress) || contacts?.[0];
+    const name = person?.displayName() || (draft ? '未填写收件人' : '未知发件人');
+    const date = draft ? row.date : row.lastMessageReceivedTimestamp;
+    const color = this.state.accountId ? '#c6cbc2' : colors[Math.max(0, AccountStore.accountIds().indexOf(row.accountId)) % colors.length];
+    return <button type="button" className={`pr-mail-row ${row.unread ? 'unread' : ''}`} key={row.id}
+      onClick={() => this.open(row)} aria-label={`${row.unread ? '未读，' : ''}${name}，${row.subject || '无主题'}`}>
+      <span className="pr-avatar" style={{ borderColor: color }} title={AccountStore.accountForId(row.accountId)?.emailAddress}><span>{Array.from(name)[0]}</span></span>
+      <span className="pr-sender">{name}</span>
+      <span className="pr-summary"><span className="pr-subject">{row.subject || '无主题'}</span><span className="pr-snippet">{this.state.snippets[row.id] || row.snippet || (draft ? '继续编辑这封草稿' : '')}</span></span>
+      <span className="pr-date">{row.unread && <span className="pr-unread" aria-hidden="true"/>}{date ? date.toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) : ''}</span>
+    </button>;
+  };
+  render() {
+    const { route, folder, selected, rows, loading, agent } = this.state;
+    const title = route === 'compose' ? '写一封信' : folders.find(f => f[0] === folder)?.[1];
+    return <div className="pr-workspace">
+      <header className="pr-titlebar"><span className="pr-brand">Paper Reed</span><span className="pr-build-label">邮件工作台 · 实验版</span></header>
+      <div className="pr-layout"><aside className="pr-sidebar" aria-label="邮箱导航">
+        <button className="pr-compose-button" onClick={this.compose}>写邮件 <span>＋</span></button>
+        <label className="pr-account-label" htmlFor="pr-account">邮箱范围</label>
+        <select id="pr-account" value={this.state.accountId} onChange={e => this.navigate(folder, e.target.value)}>
+          <option value="">全部邮箱</option>{AccountStore.accounts().map(a => <option key={a.id} value={a.id}>{a.emailAddress}</option>)}
+        </select>
+        <nav>{folders.map(([id, label]) => <button key={id} data-mailbox={id} aria-current={folder === id ? 'page' : undefined} onClick={() => this.navigate(id)}>{label}</button>)}</nav>
+        <div className="pr-sidebar-bottom"><button onClick={this.preferences}>设置</button></div>
+      </aside><main className={`pr-main pr-route-${route}`}>
+        <div className="pr-page-head">
+          {route === 'list' ? <h1>{title}</h1> : <button className="pr-back" onClick={() => this.navigate(folder)}>‹ 返回{folders.find(f => f[0] === folder)?.[1]}</button>}
+          <button className="pr-agent-button" onClick={() => this.setState({ agent: !agent, copied: false })}>连接 Agent ↗</button>
+        </div>
+        {this.state.notice && <div className="pr-notice" role="alert">{this.state.notice}<button onClick={this.refresh}>重新读取</button></div>}
+        {agent && <section className="pr-agent-panel" aria-label="Agent 交接">
+          <strong>带上当前上下文</strong><p>先复制邮件或草稿引用，再到已配置的 Agent 中粘贴。复制前会保存当前编辑。</p>
+          <div><button onClick={this.copyContext}>{this.state.copied ? '已复制上下文' : '复制上下文'}</button><button onClick={this.agentPreferences}>打开连接设置</button></div>
+          <small>实验 CLI 尚未提供一键安装；这里不会自动启动 Agent 或发送邮件。</small>
+        </section>}
+        {route === 'list' ? <>
+          <p className="pr-list-caption">{this.state.accountId ? AccountStore.accountForId(this.state.accountId)?.emailAddress : '所有已连接邮箱'}<span>{rows.length}{this.state.more ? '+' : ''} 个{folder === 'drafts' ? '草稿' : '会话'}</span></p>
+          <div className="pr-mail-list" aria-label={title}>{rows.map(this.renderRow)}
+            {!rows.length && <p className="pr-empty">{loading ? '正在读取邮件…' : '这里还没有邮件'}</p>}
+            {this.state.more && <button className="pr-load-more" onClick={() => this.setState({ limit: this.state.limit + 50 }, this.refresh)}>加载更多</button>}
+          </div>
+        </> : route === 'thread' ? <div className="pr-reader"><MessageList /></div>
+          : selected instanceof Message && <div className="pr-editor"><h1>写一封信</h1>{DraftStore.isSendingDraft(selected.headerMessageId) ? <p role="status">正在发送，请等待服务器确认…</p> : <Composer headerMessageId={selected.headerMessageId} onDraftReady={() => {}} />}</div>}
+        {!!this.state.operations.length && <details className="pr-send-results"><summary>最近发送 · {sendLabel(this.state.operations[0])}</summary>{this.state.operations.map(op => <p key={op.requestId}><span>{op.subject}</span><strong>{sendLabel(op)}</strong></p>)}</details>}
+      </main></div>
+    </div>;
+  }
+}
