+static const json & _moveClaimsForMessage(const json & move, const string & messageId) {
+    static const json none = json::array();
+    const auto recovered = move.find("recoveredMoveCopies");
+    if (recovered != move.end() && recovered->contains(messageId)) {
+        return (*recovered)[messageId]["copies"];
+    }
+    const auto queued = move.find("queuedMoveCopies");
+    return queued != move.end() && queued->contains(messageId) ? (*queued)[messageId] : none;
+}
