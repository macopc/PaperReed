diff --git a/app/internal_packages/onboarding/lib/paper-reed-google-auth.ts b/app/internal_packages/onboarding/lib/paper-reed-google-auth.ts
new file mode 100644
index 0000000..c4adc97
--- /dev/null
+++ b/app/internal_packages/onboarding/lib/paper-reed-google-auth.ts
@@ -0,0 +1,110 @@
+import crypto from 'crypto';
+import http from 'http';
+import fs from 'fs';
+import { shell } from 'electron';
+import { dialog } from '@electron/remote';
+
+const SEND_SCOPE = 'https://www.googleapis.com/auth/gmail.send';
+
+// Development setup uses the project's own Desktop client. Never reuse upstream's identity.
+export async function authorizeGmailSend(email: string) {
+  const selected = await dialog.showOpenDialog({
+    title: '选择 Paper Reed 的 Google 桌面客户端 JSON',
+    filters: [{ name: 'Google OAuth client', extensions: ['json'] }],
+    properties: ['openFile'],
+  });
+  if (selected.canceled) return null;
+  const client = JSON.parse(await fs.promises.readFile(selected.filePaths[0], 'utf8')).installed;
+  if (!client?.client_id || !client?.client_secret) {
+    throw new Error('请选择 Google OAuth「桌面应用」客户端 JSON。');
+  }
+  const verifier = crypto.randomBytes(32).toString('base64url');
+  const state = crypto.randomBytes(32).toString('hex');
+  let timer: ReturnType<typeof setTimeout>;
+  let rejectCode: (error: Error) => void;
+  let redirect: string;
+  const server = http.createServer();
+  const code = new Promise<string>((resolve, reject) => {
+    rejectCode = reject;
+    server.on('request', (req, res) => {
+      const url = new URL(req.url, redirect);
+      if (url.pathname !== '/oauth/callback') {
+        res.writeHead(404).end();
+        return;
+      }
+      if (url.searchParams.get('state') !== state) {
+        res.writeHead(400).end('Invalid OAuth state.');
+        return;
+      }
+      res.setHeader('Content-Type', 'text/plain; charset=utf-8');
+      res.setHeader('Cache-Control', 'no-store');
+      if (url.searchParams.get('error') || !url.searchParams.get('code')) {
+        res.end('授权未完成，请返回 Paper Reed 重试。');
+        reject(new Error('Google 授权已取消或未完成。'));
+      } else {
+        res.end('已收到 Google 授权，请返回 Paper Reed。');
+        resolve(url.searchParams.get('code'));
+      }
+    });
+  });
+  // Observe rejection immediately, including while the browser is opening.
+  code.catch(() => {});
+  try {
+    await new Promise<void>((resolve, reject) => {
+      server.once('error', reject);
+      server.listen(0, '127.0.0.1', resolve);
+    });
+    redirect = `http://127.0.0.1:${(server.address() as import('net').AddressInfo).port}/oauth/callback`;
+    timer = setTimeout(() => rejectCode(new Error('Google 授权等待超时，请重试。')), 10 * 60 * 1000);
+    const params = new URLSearchParams({
+      client_id: client.client_id,
+      redirect_uri: redirect,
+      response_type: 'code',
+      scope: `openid email ${SEND_SCOPE}`,
+      access_type: 'offline',
+      prompt: 'consent',
+      login_hint: email,
+      state,
+      code_challenge: crypto.createHash('sha256').update(verifier).digest('base64url'),
+      code_challenge_method: 'S256',
+    });
+    await shell.openExternal(`https://accounts.google.com/o/oauth2/v2/auth?${params}`);
+    const response = await fetch('https://oauth2.googleapis.com/token', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
+      body: new URLSearchParams({
+        client_id: client.client_id,
+        client_secret: client.client_secret,
+        code: await code,
+        code_verifier: verifier,
+        redirect_uri: redirect,
+        grant_type: 'authorization_code',
+      }).toString(),
+      signal: AbortSignal.timeout(30000),
+    });
+    if (!response.ok) throw new Error(`Google 授权交换失败（HTTP ${response.status}）。`);
+    const token = await response.json();
+    if (!token.access_token || !token.refresh_token || !token.scope?.split(' ').includes(SEND_SCOPE)) {
+      throw new Error('Google 未授予完整的发信权限，请重新授权并勾选发信权限。');
+    }
+    const identityResponse = await fetch('https://openidconnect.googleapis.com/v1/userinfo', {
+      headers: { Authorization: `Bearer ${token.access_token}` },
+      signal: AbortSignal.timeout(30000),
+    });
+    if (!identityResponse.ok) throw new Error('无法核对 Google 账号，请重试。');
+    const identity = await identityResponse.json();
+    if (!identity.email_verified || identity.email?.toLowerCase() !== email.toLowerCase()) {
+      throw new Error('授权的 Google 账号与当前邮箱不同，请选择对应账号。');
+    }
+    return {
+      gmail_api_send: true,
+      gmail_client_id: client.client_id as string,
+      gmail_client_secret: client.client_secret as string,
+      gmail_refresh_token: token.refresh_token as string,
+    };
+  } finally {
+    clearTimeout(timer);
+    server.close();
+    server.closeAllConnections();
+  }
+}
