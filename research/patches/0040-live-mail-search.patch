@@ -0,0 +1,51 @@
+import React from 'react';
+
+// Keep keystrokes local: querying is debounced, typing never re-renders the mailbox.
+export default class MailSearch extends React.Component<{
+  query: string;
+  onSearch: (query: string) => void;
+  onPending: () => void;
+}, { text: string; pending: boolean }> {
+  state = { text: this.props.query, pending: false };
+  timer: ReturnType<typeof setTimeout>;
+  composing = false;
+  componentDidUpdate(previous: Readonly<typeof this.props>) {
+    if (previous.query !== this.props.query && this.props.query !== this.state.text.trim()) {
+      clearTimeout(this.timer);
+      this.setState({ text: this.props.query, pending: false });
+    }
+  }
+  componentWillUnmount() { clearTimeout(this.timer); }
+  submit = () => {
+    clearTimeout(this.timer);
+    if (this.composing) return;
+    this.setState({ pending: false });
+    this.props.onSearch(this.state.text);
+  };
+  change = (text: string) => {
+    clearTimeout(this.timer);
+    this.props.onPending();
+    this.setState({ text, pending: true });
+    if (!this.composing) this.timer = setTimeout(this.submit, 180);
+  };
+  render() {
+    return (
+      <form className="pr-search" role="search" onSubmit={(event) => {
+        event.preventDefault(); this.submit();
+      }}>
+        <label className="sr-only" htmlFor="pr-mail-search">搜索本机邮件</label>
+        <input id="pr-mail-search" className="pr-search-input" value={this.state.text}
+          placeholder="搜索邮件 · 发件人、主题或正文"
+          onChange={(event) => this.change(event.target.value)}
+          onCompositionStart={() => { this.composing = true; clearTimeout(this.timer); }}
+          onCompositionEnd={(event) => { this.composing = false; this.change(event.currentTarget.value); }} />
+        {this.state.pending && <span role="status">输入中 · 列表尚未更新</span>}
+        {!!this.state.text && <button type="button" onClick={() => {
+          clearTimeout(this.timer);
+          this.setState({ text: '', pending: false });
+          this.props.onSearch('');
+        }}>清除</button>}
+      </form>
+    );
+  }
+}
