+            if (!actionAvailable(input.action, target.accountId))
+              throw new Error('unsupported-mailbox-action');
+            let task: ChangeMailTask;
+            let undoable = true;
+            if (input.action === 'read' || input.action === 'unread') {
+              const unread = input.action === 'unread';
+              messages = messages.filter((m) => m.unread !== unread);
+              // Mixed flags across copies cannot be reversed exactly by the existing unread task.
+              undoable = messages.every((m) =>
+                Object.values(m.folders || {}).every((bits) => !!(bits & 1) === !unread)
+              );
+              task = new ChangeUnreadTask({ messages, unread, source: 'Paper Reed' });
+            } else {
+              const destination =
+                input.action === 'archive'
+                  ? CategoryStore.getArchiveCategory(target.accountId)
+                  : CategoryStore.getCategoryByRole(target.accountId, input.action);
+              if (!isFolderAllowed(access.grant(), target.accountId, destination.id))
+                throw new Error('Access denied: destination excluded');
+              let sourceFolderIds: string[] = [];
+              if (input.action === 'archive')
+                sourceFolderIds = [CategoryStore.getInboxCategory(target.accountId).id];
+              if (input.action === 'inbox')
+                sourceFolderIds = ['trash', 'spam']
+                  .map((role) => CategoryStore.getCategoryByRole(target.accountId, role)?.id)
+                  .filter(Boolean);
+              if (sourceFolderIds.length)
+                messages = messages.filter((m) =>
+                  m.folderIds().some((id) => sourceFolderIds.includes(id))
+                );
+              else
+                messages = messages.filter((m) =>
+                  m.folderIds().some((id) => id !== destination.id)
+                );
+              task = new ChangeFolderTask({
+                messages,
+                folder: destination as Folder,
+                sourceFolderIds,
+                source: 'Paper Reed',
+              });
+            }
+            if (!messages.length) return { ...target, status: 'unchanged' };
+            task.id = id;
+            task.paperReed = {
+              action: input.action,
+              threadId: target.threadId,
+              requestId: input.requestId,
+              undoable,
+            };
+            access.check(target.accountId, true);
+            if (messages.some((m) => !isMessageAllowed(access.grant(), m)))
+              throw new Error('Access denied: excluded mail');
+            return queued(task);
+          })()
+        );
+      try {
+        const result = await pending.get(pendingKey);
+        items.push(result);
+        if (result.status === 'unchanged') pending.delete(pendingKey);
+      } catch (e) {
+        pending.delete(pendingKey);
+        throw e;
+      }
+    } catch (error) {
+      items.push({ ...target, status: 'rejected', error: error.message });
+    }
+  }
+  return { items };
+}
+export async function undoMail(ref: { accountId: string; taskId: string }, access: InboxAccess) {
+  const task = await taskFor(ref.accountId, ref.taskId, access, true);
+  if (taskState(task) !== 'succeeded' || task.isUndo || !task.paperReed.undoable)
+    throw new Error('undo-unavailable');
+  const id = taskId(task.accountId, 'undo', task.id);
+  const existing = await DatabaseStore.find<ChangeMailTask>(Task, id);
+  if (existing) return receipt(await taskFor(task.accountId, id, access, true));
+  const key = id + ':undo';
+  if (!pending.has(key))
+    pending.set(
+      key,
+      (async () => {
+        const task = await taskFor(ref.accountId, ref.taskId, access, true);
+        // No fallback to a guessed source folder: use only the engine's recorded placements.
+        if (task instanceof ChangeFolderTask && !task.undoPlacements)
+          throw new Error('undo-snapshot-missing');
+        if (task instanceof ChangeFolderTask) {
+          for (const entries of Object.values(task.undoPlacements))
+            for (const { folderId } of entries)
+              if (!isFolderAllowed(access.grant(), task.accountId, folderId))
+                throw new Error('Access denied: restore folder excluded');
+        }
+        const tasks = task.createUndoTasks() as ChangeMailTask[];
+        if (tasks.length !== 1) throw new Error('undo-unavailable');
+        const undo = tasks[0];
+        undo.id = id;
+        undo.paperReed = { ...task.paperReed, undoable: false };
+        access.check(task.accountId, true);
+        return queued(undo);
+      })()
+    );
+  try {
+    return await pending.get(key);
+  } catch (error) {
+    pending.delete(key);
+    throw error;
+  }
+}
