+export function serverConnectionProblem(error: {
+  errorCode?: string;
+  errorService?: string;
+  errorAdvice?: string;
+  isNetworkError?: boolean;
+  message?: string;
+}, account: Account) {
+  const outgoing = error.errorService === 'smtp';
+  const server = outgoing ? '发信服务器' : '收信服务器';
+  const protocol = outgoing ? 'smtp' : 'imap';
+  if (['ErrorAuthentication', 'ErrorAuthenticationRequired'].includes(error.errorCode)) {
+    return {
+      message: `${server}拒绝登录。请核对用户名和密码，或使用服务商要求的应用专用密码。`,
+      errorFieldNames: [`settings.${protocol}_username`, `settings.${protocol}_password`],
+    };
+  }
+  if (error.errorCode === 'ErrorCertificate') {
+    return {
+      message: `无法验证${server}的证书。请核对服务器地址和证书。使用私有证书时，请确认来源，再按服务商说明加入系统信任。`,
+    };
+  }
+  if (error.errorAdvice) {
+    const next = account.settings[`${protocol}_allow_insecure_ssl`]
+      ? '已允许旧版 TLS，请联系服务商更新加密设置。'
+      : '若服务商确认需要旧版加密，可在该服务器的高级设置中允许旧版 TLS。';
+    return { message: `无法与${server}建立安全连接。请核对端口和加密方式。${next}` };
+  }
+  if (['ErrorTLSNotAvailable', 'ErrorStartTLSNotAvailable'].includes(error.errorCode)) {
+    return { message: `无法与${server}建立安全连接。请核对端口和加密方式。` };
+  }
+  if (error.isNetworkError) return { message: '网络连接中断。请检查网络后重试。' };
+  if (error.errorCode === 'ErrorConnection') {
+    return { message: `无法连接${server}。请检查服务器地址和端口后重试。` };
+  }
+  if (error.errorCode === 'ErrorNeedsConnectToWebmail') {
+    return { message: '请先登录邮箱网页版，完成服务商要求的操作后重试。' };
+  }
+  return { message: error.message || '未能连接邮箱。请核对服务器设置后重试。' };
+}
+
 export async function finalizeAndValidateAccount(account: Account, existingId?: string) {
+  if (AppEnv.config.get('core.paperReed.enabled')) {
+    // Paper Reed keeps reviewed fingerprints on the onboarding draft only. They are
+    // omitted from validation requests and from the account saved after validation.
+    delete account.settings.imap_certificate_sha256;
+    delete account.settings.smtp_certificate_sha256;
+  }
   if (account.settings.imap_host) {
     account.settings.imap_host = account.settings.imap_host.trim();
   }
