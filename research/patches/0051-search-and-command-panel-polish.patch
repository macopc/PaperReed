diff --git a/app/internal_packages/paper-reed/styles/paper-reed.less b/app/internal_packages/paper-reed/styles/paper-reed.less
index eb31d8e..69718e1 100644
--- a/app/internal_packages/paper-reed/styles/paper-reed.less
+++ b/app/internal_packages/paper-reed/styles/paper-reed.less
@@ -690,13 +690,26 @@
 }
 
 .pr-command-trigger { margin-left:auto; background:transparent; border:0; color:#626b60; font-size:12px; }
-.pr-command-panel { width:480px; max-height:70vh; padding:20px; border:1px solid #d9ddd2; border-radius:12px; color:#303730; background:#faf9f4; box-shadow:0 20px 70px #25322530; }
+.pr-command-panel { width:min(480px, calc(100vw - 48px)); max-height:70vh; padding:20px; border:1px solid #d9ddd2; border-radius:12px; color:#303730; background:#faf9f4; box-shadow:0 20px 70px #25322530; }
 .pr-command-panel::backdrop { background:#25322535; }
-.pr-command-panel header { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; }
+.pr-command-panel header { display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; font-size:13px; font-weight:500; }
 .pr-command-panel header button { background:none; border:0; color:#626b60; }
-.pr-command-panel input { width:100%; margin-bottom:12px; }
+.pr-command-panel input {
+  box-sizing:border-box;
+  width:100%;
+  margin-bottom:8px;
+  padding:7px 10px;
+  color:#303730;
+  font:inherit;
+  border:1px solid #d9ddd2;
+  border-radius:5px;
+  background:#fffefa;
+}
+.pr-command-panel input:focus { border-color:#4b634f; outline:1px solid #4b634f; }
+.pr-command-panel kbd { color:#626b60; font:inherit; font-size:11px; }
+.pr-command-empty { margin:24px 0; text-align:center; color:#626b60; }
 .pr-command-results { max-height:42vh; overflow:auto; }
 .pr-command-results button { display:flex; align-items:center; justify-content:space-between; width:100%; padding:10px 12px; border:0; border-radius:6px; background:transparent; text-align:left; }
-.pr-command-results button.active, .pr-command-results button:hover { background:#e9eee5; }
+.pr-command-results button.active, .pr-command-results button:not(:disabled):hover { background:#e9eee5; }
 .pr-command-results button:disabled { opacity:.4; }
 .pr-command-panel footer { margin-top:16px; color:#747a70; font-size:11px; }
