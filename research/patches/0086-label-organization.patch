+.paper-reed-enabled .pr-workspace {
+  .pr-label-manager { max-width: 960px; }
+  .pr-label-manager .pr-page-head { margin-bottom: 16px; }
+  .pr-label-manager h1:focus { outline: none; }
+  .pr-label-manager .pr-page-head button, .pr-label-scope { color: var(--pr-muted); }
+  .pr-label-scope { margin: 16px 0 24px; }
+  .pr-organization-nav { display: flex; align-items: baseline; gap: 16px; border-bottom: 1px solid var(--pr-line); }
+  .pr-organization-nav span { padding: 8px 0; border-bottom: 2px solid var(--pr-reed); color: var(--pr-reed); font-weight: 600; }
+  .pr-organization-nav button { color: var(--pr-reed); }
+  .pr-label-layout { display: grid; grid-template-columns: minmax(168px, 1fr) minmax(240px, 1.45fr); gap: 24px; }
+  .pr-label-collection { min-width: 0; }
+  .pr-label-collection-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding-bottom: 8px; border-bottom: 1px solid var(--pr-line); }
+  .pr-label-manager h2 { margin: 0; font-size: 14px; font-weight: 600; line-height: 24px; }
+  .pr-label-collection-head button { color: var(--pr-reed); white-space: nowrap; }
+  .pr-label-collection p { color: var(--pr-muted); padding: 0 8px; }
+  .pr-label-collection ul { list-style: none; padding: 0; margin: 8px 0 0; }
+  .pr-label-collection li { margin: 0; }
+  .pr-label-collection li button { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; min-height: 36px; }
+  .pr-label-collection li button[aria-pressed=true] { background: #e9eee5; color: var(--pr-reed); }
+  .pr-label-collection li button span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+  .pr-label-collection .pr-label-dot { width: 10px; height: 10px; }
+  .pr-label-edit { min-width: 0; align-self: start; padding: 20px; border: 1px solid var(--pr-line); border-radius: 6px; background: #fffefa; }
+  .pr-label-fields { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; margin: 16px 0; }
+  .pr-label-fields label { display: grid; gap: 6px; color: var(--pr-muted); }
+  .pr-label-fields input { width: 100%; min-width: 0; height: 34px; margin: 0; border: 1px solid #c6cbc2; border-radius: 4px; background: var(--pr-paper); color: var(--pr-ink); font: inherit; padding: 4px 8px; }
+  .pr-label-fields input:focus-visible { outline: 2px solid var(--pr-reed); outline-offset: 2px; }
+  .pr-label-fields input[type=color] { width: 42px; padding: 4px; }
+  .pr-label-edit-actions { display: flex; flex-wrap: wrap; gap: 8px; }
+  .pr-label-edit-actions button[type=submit] { background: var(--pr-reed); color: #fffefa; }
+  .pr-label-manager button[aria-disabled=true] { opacity: .5; cursor: default; }
+  .pr-label-confirm { border-top: 1px solid var(--pr-line); margin-top: 16px; overflow-wrap: anywhere; }
+  .pr-label-confirm button:last-child, .pr-label-edit .pr-delete-label { color: #9a433e; }
+  .pr-label-status { margin: 12px 0 0; color: var(--pr-reed); }
+  @media (max-width: 690px) {
+    .pr-label-layout { grid-template-columns: minmax(0, 1fr); }
+  }
+}
