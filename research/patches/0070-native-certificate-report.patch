+void mailcore::reportRejectedCertificate(mailstream *stream, ConnectionLogger *logger)
+{
+    if (!logger || !logger->wantsRejectedCertificate()) {
+        return;
+    }
+    carray *chain = mailstream_get_certificate_chain(stream);
+    if (!chain) {
+        return;
+    }
+    if (carray_count(chain) > 0) {
+        auto leaf = static_cast<MMAPString *>(carray_get(chain, 0));
+        if (leaf && leaf->len > 0) {
+            logger->logRejectedCertificate(Data::dataWithBytes(leaf->str, leaf->len));
+        }
+    }
+    mailstream_certificate_chain_free(chain);
+}
