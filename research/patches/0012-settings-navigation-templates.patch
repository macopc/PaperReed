+
+.preferences-wrap.pr-preferences { background:#faf9f6; color:#303730;
+  > .flexbox { min-width:0; }
+  .pr-preferences-nav { flex:0 0 180px; padding:24px 16px; border-right:1px solid #dfe2d9; overflow-y:auto; }
+  .pr-settings-brand { font:22px/30px 'Iowan Old Style',serif; margin:0 8px 24px; }
+  .pr-preferences-nav h2 { font-size:11px; font-weight:400; color:#626b60; margin:24px 10px 10px; }
+  .pr-preferences-nav button { display:block; width:100%; text-align:left; padding:9px 12px; margin:2px 0; background:transparent; color:#303730; border:0; border-radius:5px; font:12px/20px -apple-system,sans-serif; cursor:pointer; }
+  .pr-preferences-nav button:hover { background:#f2f1eb; }
+  .pr-preferences-nav button[aria-current] { background:#e9eee5; color:#4b634f; font-weight:500; }
+  .pr-preferences-nav button:focus-visible { outline:2px solid #4b634f; outline-offset:-2px; }
+  .pr-preferences-nav .pr-settings-back { color:#626b60; }
+  .preferences-content { flex:1; min-width:0; background:#faf9f6; }
+  .preferences-signatures-container.pr-signature-settings { max-width:1000px; padding:32px 36px; }
+}
+.preferences-signatures-container.pr-signature-settings {
+  .pr-signature-templates { padding:16px 0 4px; }
+  .signature-wrap > .section:has(.pr-signature-templates) { background:transparent; border:0; }
+  .pr-template-heading { font-size:12px; color:#303730; margin-bottom:10px; }
+  .pr-template-heading > span { color:#626b60; font-size:11px; margin-left:10px; }
+  .pr-template-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }
+  .pr-template-grid button { min-width:0; padding:0; overflow:hidden; text-align:left; background:#fffefa; border:1px solid #dfe2d9; border-radius:5px; }
+  .pr-template-grid button[aria-pressed=true], .pr-template-html[aria-pressed=true] { border-color:#4b634f; box-shadow:inset 0 0 0 1px #4b634f; }
+  .pr-template-preview { display:block; height:88px; position:relative; overflow:hidden; pointer-events:none; }
+  .pr-template-preview > span { display:block; width:270px; position:absolute; left:12px; top:12px; transform:scale(.65); transform-origin:top left; }
+  .pr-template-name { display:block; padding:7px 10px; background:#f2f1eb; color:#303730; font-size:11px; border-top:1px solid #dfe2d9; }
+  .pr-template-grid button[aria-pressed=true] .pr-template-name { background:#e9eee5; color:#4b634f; }
+  .pr-template-html { margin-top:8px; width:100%; text-align:left; padding:10px; font-size:12px; background:transparent; }
+  .pr-template-html span { font-size:11px; color:#626b60; margin-left:10px; }
+  @media(max-width:1000px) { .pr-signature-layout { grid-template-columns:120px minmax(0,1fr); gap:18px; } .pr-template-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .pr-template-preview > span { transform:scale(.5); } }
+}
