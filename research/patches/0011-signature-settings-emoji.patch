diff --git a/app/src/components/composer-editor/paper-reed-emoji-picker.tsx b/app/src/components/composer-editor/paper-reed-emoji-picker.tsx
new file mode 100644
index 0000000..4a6bc72
--- /dev/null
+++ b/app/src/components/composer-editor/paper-reed-emoji-picker.tsx
@@ -0,0 +1,41 @@
+import React from 'react';
+import { Actions } from 'mailspring-exports';
+import categories from './categorized-emoji';
+import { getEmojiImagePath, searchEmojiNames } from './emoji-plugins';
+
+const labels = { People:'表情与人物', Nature:'动物与自然', 'Food and Drink':'食物与饮品', Activity:'活动', 'Travel and Places':'旅行与地点', Objects:'物品', Symbols:'符号', Flags:'旗帜' };
+
+export default class PaperReedEmojiPicker extends React.Component<{onInsertEmoji:(name:string)=>void}> {
+  state = { query:'', category:'People' };
+  input: HTMLInputElement;
+  focusFrame: number;
+  componentDidMount() { this.focusFrame = requestAnimationFrame(() => this.input.focus()); }
+  componentWillUnmount() { cancelAnimationFrame(this.focusFrame); }
+  render() {
+    const query = this.state.query.trim().toLowerCase();
+    const names: string[] = query ? searchEmojiNames(query) : categories[this.state.category];
+    return <div className="pr-emoji-picker" onKeyDown={event => {
+      if (event.key === 'Escape') { event.preventDefault(); event.stopPropagation(); Actions.closePopover(); }
+    }}>
+      <header><strong>表情</strong><button type="button" onClick={() => Actions.closePopover()} aria-label="关闭表情选择器">关闭</button></header>
+      <input ref={el => this.input = el} aria-label="搜索表情（英文名称）" placeholder="搜索英文名称，如 smile" value={this.state.query}
+        onChange={event => this.setState({query:event.target.value})}
+        onKeyDown={event => { if (event.key === 'ArrowDown' && names.length) { event.preventDefault(); event.stopPropagation(); event.currentTarget.parentElement.querySelector<HTMLButtonElement>('.pr-emoji-grid button')?.focus(); } }} />
+      <select aria-label="表情分类" value={this.state.category} onChange={event => this.setState({category:event.target.value,query:''})}>
+        {Object.keys(categories).map(category => <option key={category} value={category}>{labels[category] || category}</option>)}
+      </select>
+      <div className="pr-emoji-grid" aria-label={query ? '搜索结果' : labels[this.state.category]} onKeyDown={event => {
+        const delta = {ArrowRight:1,ArrowLeft:-1,ArrowDown:6,ArrowUp:-6}[event.key];
+        if (!delta) return;
+        const buttons = Array.from(event.currentTarget.querySelectorAll('button'));
+        const index = buttons.indexOf(event.target as HTMLButtonElement);
+        if (index < 0) return;
+        event.preventDefault(); buttons[Math.max(0,Math.min(buttons.length-1,index+delta))]?.focus();
+      }}>
+        {names.map(name => <button type="button" key={name} title={name.replace(/_/g,' ')} aria-label={name.replace(/_/g,' ')} onKeyDown={event => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); event.stopPropagation(); this.props.onInsertEmoji(name); } }} onClick={() => this.props.onInsertEmoji(name)}><img src={getEmojiImagePath(name)} alt="" loading="lazy" /></button>)}
+      </div>
+      {!names.length && <p role="status">没有匹配的表情，试试其他英文名称。</p>}
+      <footer>方向键选择 · Enter 插入 · Esc 关闭</footer>
+    </div>;
+  }
+}
