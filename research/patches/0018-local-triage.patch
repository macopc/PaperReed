diff --git a/app/internal_packages/paper-reed/lib/triage-controls.tsx b/app/internal_packages/paper-reed/lib/triage-controls.tsx
new file mode 100644
index 0000000..2b5a508
--- /dev/null
+++ b/app/internal_packages/paper-reed/lib/triage-controls.tsx
@@ -0,0 +1,336 @@
+import React, { useState, useRef } from 'react';
+import {
+  changeLocalMail,
+  editLocalLabel,
+  LocalChange,
+  LocalLabel,
+  LocalState,
+} from '../../../src/services/mail-core/local-triage';
+import { inboxDesktopAccess, MailTarget } from '../../../src/services/mail-core/inbox';
+
+export const triageError = (message: string) =>
+  ({
+    'invalid-snooze-time': '请选择未来的时间。',
+    'snooze-requires-inbox': '只能稍后处理收件箱中的邮件。',
+    'snooze-needs-synced-inbox': '请等待收件箱同步完成后重试。',
+    'duplicate-label-name': '已有同名标签，请换一个名称。',
+    'invalid-label-name': '标签名称需为 1–40 个字符。',
+    'label-not-found': '这个标签已被删除，请重新选择。',
+  })[message] || message;
+export const localTime = (time: number) =>
+  new Date(time).toLocaleString(undefined, {
+    month: 'short',
+    day: 'numeric',
+    hour: '2-digit',
+    minute: '2-digit',
+  });
+export function PinMark() {
+  return (
+    <svg className="pr-pin-mark" viewBox="0 0 16 16" width="12" height="12" aria-label="已置顶">
+      <path
+        d="M6 2h4m-3 0v4l-3 4h8l-3-4V2M8 10v4"
+        fill="none"
+        stroke="currentColor"
+        strokeWidth="1.2"
+        strokeLinecap="round"
+        strokeLinejoin="round"
+      />
+    </svg>
+  );
+}
+export function TriageControls({
+  targets,
+  states,
+  labels,
+  busy,
+  onBusy,
+  onDone,
+}: {
+  targets: MailTarget[];
+  states: Record<string, LocalState>;
+  labels: LocalLabel[];
+  busy: boolean;
+  onBusy: (busy: boolean) => void;
+  onDone: () => void;
+}) {
+  const [panel, setPanel] = useState('');
+  const [error, setError] = useState('');
+  const [date, setDate] = useState('');
+  const trigger = useRef<HTMLButtonElement>(null);
+  const labelTrigger = useRef<HTMLButtonElement>(null);
+  const restoreFocus = () => (panel === 'labels' ? labelTrigger : trigger).current?.focus();
+  const pinned = targets.every((t) => states[t.threadId]?.pinned);
+  const snoozed = targets.some((t) => states[t.threadId]?.snoozeUntil);
+  const run = async (change: Omit<LocalChange, 'targets'>) => {
+    onBusy(true);
+    setError('');
+    try {
+      const result = await changeLocalMail({ ...change, targets }, inboxDesktopAccess);
+      const failed = result.items.filter((i) => i.status === 'rejected');
+      if (failed.length)
+        setError(
+          `${result.items.length - failed.length} / ${result.items.length} 完成 · ${triageError(failed[0].error)}`
+        );
+      else {
+        setPanel('');
+        restoreFocus();
+      }
+      onDone();
+    } catch (e) {
+      setError(triageError(e.message));
+    } finally {
+      onBusy(false);
+    }
+  };
+  const later = (tomorrow = false) => {
+    const d = new Date(tomorrow ? Date.now() : Date.now() + 3 * 60 * 60 * 1000);
+    if (tomorrow) {
+      d.setDate(d.getDate() + 1);
+      d.setHours(9, 0, 0, 0);
+    }
+    return d.toISOString();
+  };
+  return (
+    <section
+      className="pr-local-controls"
+      aria-label="本机整理"
+      onKeyDown={(e) => {
+        if (e.key === 'Escape') {
+          setPanel('');
+          restoreFocus();
+          e.stopPropagation();
+        }
+      }}
+    >
+      <div className="pr-local-buttons">
+        <button
+          disabled={busy}
+          data-local-action={pinned ? 'unpin' : 'pin'}
+          onClick={() => run({ action: pinned ? 'unpin' : 'pin' })}
+        >
+          {pinned ? '取消置顶' : '置顶'}
+        </button>
+        <button
+          disabled={busy}
+          ref={trigger}
+          data-local-panel="snooze"
+          aria-expanded={panel === 'snooze'}
+          onClick={() => {
+            setPanel(panel === 'snooze' ? '' : 'snooze');
+            setError('');
+          }}
+        >
+          稍后处理
+        </button>
+        {snoozed && (
+          <button
+            disabled={busy}
+            data-local-action="unsnooze"
+            onClick={() => run({ action: 'unsnooze' })}
+          >
+            结束稍后
+          </button>
+        )}
+        <button
+          disabled={busy}
+          ref={labelTrigger}
+          data-local-panel="labels"
+          aria-expanded={panel === 'labels'}
+          onClick={() => {
+            setPanel(panel === 'labels' ? '' : 'labels');
+            setError('');
+          }}
+        >
+          标签
+        </button>
+        <span>仅在本机</span>
+      </div>
+      {panel === 'snooze' && (
+        <div className="pr-local-panel" aria-label="稍后时间">
+          <div className="pr-snooze-presets">
+            <button disabled={busy} onClick={() => run({ action: 'snooze', until: later() })}>
+              3 小时后
+            </button>
+            <button disabled={busy} onClick={() => run({ action: 'snooze', until: later(true) })}>
+              明天 09:00
+            </button>
+          </div>
+          <form
+            onSubmit={(e) => {
+              e.preventDefault();
+              const time = new Date(date).getTime();
+              if (!Number.isFinite(time)) {
+                setError('请选择有效的时间。');
+                return;
+              }
+              run({ action: 'snooze', until: new Date(time).toISOString() });
+            }}
+          >
+            <label>
+              自定时间
+              <input
+                autoFocus
+                type="datetime-local"
+                value={date}
+                onChange={(e) => setDate(e.target.value)}
+                required
+              />
+            </label>
+            <button disabled={busy} type="submit">
+              设定
+            </button>
+          </form>
+          <small>按系统时区显示 · 到期或有新来信时回到列表；退出后将在下次打开时恢复。</small>
+        </div>
+      )}
+      {panel === 'labels' && (
+        <div className="pr-local-panel pr-label-picker" aria-label="选择本机标签">
+          {!labels.length && <p>还没有标签，请从左侧“标签 · 管理”创建。</p>}
+          {labels.map((l) => {
+            const n = targets.filter((t) =>
+              states[t.threadId]?.labels.some((x) => x.id === l.id)
+            ).length;
+            return (
+              <label key={l.id}>
+                <input
+                  type="checkbox"
+                  disabled={busy}
+                  checked={n === targets.length}
+                  ref={(el) => {
+                    if (el) el.indeterminate = n > 0 && n < targets.length;
+                  }}
+                  onChange={(e) =>
+                    run({ action: e.target.checked ? 'label-add' : 'label-remove', labelId: l.id })
+                  }
+                />
+                <i className="pr-label-dot" style={{ backgroundColor: l.color }} />
+                {l.name}
+                {n > 0 && n < targets.length && <small>部分已添加</small>}
+              </label>
+            );
+          })}
+        </div>
+      )}
+      {error && (
+        <p className="pr-local-error" role="alert">
+          {error}
+        </p>
+      )}
+    </section>
+  );
+}
+export function LabelManager({
+  labels,
+  onDone,
+  onClose,
+}: {
+  labels: LocalLabel[];
+  onDone: () => void;
+  onClose: () => void;
+}) {
+  const [id, setId] = useState('');
+  const [name, setName] = useState('');
+  const [color, setColor] = useState('#688177');
+  const [error, setError] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [confirm, setConfirm] = useState(false);
+  const choose = (id: string) => {
+    const label = labels.find((l) => l.id === id);
+    setId(id);
+    setName(label?.name || '');
+    setColor(label?.color || '#688177');
+    setConfirm(false);
+    setError('');
+  };
+  const save = async (remove = false) => {
+    setBusy(true);
+    setError('');
+    try {
+      await editLocalLabel({ id: id || undefined, name, color, remove }, inboxDesktopAccess);
+      choose('');
+      onDone();
+    } catch (e) {
+      setError(triageError(e.message));
+    } finally {
+      setBusy(false);
+    }
+  };
+  return (
+    <section className="pr-label-manager pr-local-panel" aria-label="管理本机标签">
+      <header>
+        <strong>本机标签</strong>
+        <button onClick={onClose} aria-label="关闭标签管理">
+          关闭
+        </button>
+      </header>
+      <p>名称与颜色在所有邮箱中共用。</p>
+      <form
+        onSubmit={(e) => {
+          e.preventDefault();
+          save();
+        }}
+      >
+        <label>
+          标签
+          <select
+            aria-label="编辑标签"
+            value={id}
+            onChange={(e) => choose(e.target.value)}
+            disabled={busy}
+          >
+            <option value="">新建标签</option>
+            {labels.map((l) => (
+              <option key={l.id} value={l.id}>
+                {l.name}
+              </option>
+            ))}
+          </select>
+        </label>
+        <label>
+          名称
+          <input
+            autoFocus
+            aria-label="标签名称"
+            value={name}
+            maxLength={40}
+            onChange={(e) => setName(e.target.value)}
+            disabled={busy}
+            required
+          />
+        </label>
+        <label>
+          颜色
+          <input
+            type="color"
+            aria-label="标签颜色"
+            value={color}
+            onChange={(e) => setColor(e.target.value)}
+            disabled={busy}
+          />
+        </label>
+        <button type="submit" disabled={busy}>
+          {id ? '保存' : '创建'}
+        </button>
+        {id && (
+          <button type="button" disabled={busy} onClick={() => setConfirm(true)}>
+            删除标签
+          </button>
+        )}
+      </form>
+      {confirm && (
+        <div role="alert">
+          <p>删除“{labels.find((l) => l.id === id)?.name}”及其本机标记？邮件会保留。</p>
+          <button disabled={busy} onClick={() => save(true)}>
+            确认删除
+          </button>
+          <button onClick={() => setConfirm(false)}>取消</button>
+        </div>
+      )}
+      {error && (
+        <p className="pr-local-error" role="alert">
+          {error}
+        </p>
+      )}
+    </section>
+  );
+}
