+import React from 'react';
+import { clipboard } from '@electron/remote';
+import { AccountStore } from 'mailspring-exports';
+import {
+  cliPaths,
+  cliStatus,
+  cliConnection,
+  installCLI,
+  uninstallCLI,
+  checkCLI,
+  cliDoctorCommand,
+  agentHandoff,
+} from './paper-reed-cli';
+
+export default class PreferencesPaperReedCLI extends React.Component<
+  Record<string, never>,
+  { busy: boolean; message: string; failed: boolean; confirmRemove: boolean; checked: boolean }
+> {
+  state = { busy: false, message: '', failed: false, confirmRemove: false, checked: false };
+  mounted = false;
+  connection = cliConnection();
+  componentDidMount() {
+    this.mounted = true;
+  }
+  componentWillUnmount() {
+    this.mounted = false;
+  }
+  componentDidUpdate() {
+    const current = cliConnection();
+    if (current.endpoint !== this.connection.endpoint || current.token !== this.connection.token) {
+      this.connection = current;
+      this.setState({
+        message: '连接信息已变化，请更新 CLI 连接后重新检查。',
+        failed: false,
+        checked: false,
+      });
+    }
+  }
+  perform = async (action: () => Promise<string> | string) => {
+    this.setState({ busy: true, message: '', failed: false });
+    try {
+      const message = await action();
+      if (this.mounted) this.setState({ message, busy: false });
+    } catch (error) {
+      if (this.mounted) this.setState({ message: error.message, busy: false, failed: true });
+    }
+  };
+  render() {
+    const state = cliStatus(),
+      paths = cliPaths();
+    const { busy, message, failed, confirmRemove } = this.state;
+    return (
+      <section className="pr-settings-group pr-cli-setup" aria-label="CLI 安装与接入">
+        <header>
+          <h2>连接你的 Agent</h2>
+          <span>
+            {state.blocked
+              ? '安装受阻'
+              : state.ready
+                ? 'CLI 已安装'
+                : state.installed
+                  ? '连接待更新'
+                  : 'CLI 未安装'}
+          </span>
+        </header>
+        <p>
+          Claude Code、Codex、OpenCode 等可运行本机命令的 Agent，都可以通过 CLI 使用已授权的邮件。
+        </p>
+        <div className="pr-cli-actions">
+          <button
+            type="button"
+            data-cli-action="install"
+            className={!state.ready ? 'primary' : undefined}
+            disabled={busy || state.blocked}
+            onClick={() =>
+              this.perform(async () => {
+                await installCLI();
+                if (this.mounted) this.setState({ checked: false });
+                return 'CLI 已安装，连接已保存。下一步：检查连接。';
+              })
+            }
+          >
+            {state.installed ? '更新 CLI 连接' : '安装 CLI'}
+          </button>
+          <button
+            type="button"
+            data-cli-action="doctor"
+            className={state.ready && !this.state.checked ? 'primary' : undefined}
+            disabled={busy || !state.ready}
+            onClick={() =>
+              this.perform(async () => {
+                const result = await checkCLI();
+                if (this.mounted) this.setState({ checked: true });
+                return result.authorizedAccounts
+                  ? `连接正常 · ${result.authorizedAccounts} 个邮箱可访问。可复制接入说明给 Agent。`
+                  : '连接正常，但没有可访问的邮箱。请在下方调整邮箱范围。';
+              })
+            }
+          >
+            检查连接
+          </button>
+          <button
+            type="button"
+            data-cli-action="copy"
+            className={state.ready && this.state.checked ? 'primary' : undefined}
+            disabled={busy || !state.ready}
+            onClick={() =>
+              this.perform(() => {
+                clipboard.writeText(
+                  agentHandoff({
+                    scope: 'mailbox',
+                    accountIds: AccountStore.accountIds(),
+                    mailbox: 'inbox',
+                  })
+                );
+                return '接入说明已复制。粘贴到 Agent 会话即可开始；也可从邮件或草稿页复制当前任务。';
+              })
+            }
+          >
+            复制接入说明
+          </button>
+        </div>
+        <p className={`pr-cli-feedback ${failed ? 'error' : ''}`} role="status">
+          {busy
+            ? '正在处理…'
+            : message ||
+              state.message ||
+              (state.ready
+                ? '检查连接后，把接入说明粘贴到 Agent 会话。'
+                : '命令仅安装到当前用户目录，邮件操作沿用下方权限。')}
+        </p>
+        <details className="pr-cli-help">
+          <summary>命令位置与终端使用</summary>
+          <p>
+            命令位于 <code>{paths.command}</code>。复用当前应用的运行环境，无需另装
+            Node。移动或替换应用后，请重新安装 CLI。
+          </p>
+          <div className="pr-cli-terminal">
+            <code>{cliDoctorCommand()}</code>
+            <button
+              type="button"
+              disabled={busy || !state.ready}
+              onClick={() =>
+                this.perform(() => {
+                  clipboard.writeText(cliDoctorCommand());
+                  return '检查命令已复制。';
+                })
+              }
+            >
+              复制检查命令
+            </button>
+          </div>
+          <p>
+            如果终端提示找不到 paper-reed，可直接使用上面的完整路径，或自行把 ~/.local/bin 加入
+            PATH。
+          </p>
+          <p>
+            <a href="https://github.com/macopc/PaperReed/blob/main/research/cli/README.md">
+              查看 CLI 使用说明 ↗
+            </a>
+          </p>
+          {state.installed &&
+            (confirmRemove ? (
+              <div className="pr-cli-remove">
+                <p>仅移除命令和本机 CLI 连接文件，邮件与 MCP 设置保留。</p>
+                <button
+                  type="button"
+                  disabled={busy}
+                  onClick={() => this.setState({ confirmRemove: false })}
+                >
+                  取消
+                </button>
+                <button
+                  type="button"
+                  disabled={busy}
+                  data-cli-action="remove-confirm"
+                  onClick={() =>
+                    this.perform(() => {
+                      uninstallCLI();
+                      this.setState({ confirmRemove: false });
+                      return 'CLI 已移除。';
+                    })
+                  }
+                >
+                  确认移除
+                </button>
+              </div>
+            ) : (
+              <button
+                type="button"
+                data-cli-action="remove"
+                disabled={busy}
+                onClick={() => this.setState({ confirmRemove: true })}
+              >
+                移除 CLI…
+              </button>
+            ))}
+        </details>
+      </section>
+    );
+  }
+}
