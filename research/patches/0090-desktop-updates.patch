diff --git a/app/src/browser/paper-reed-update-feed.ts b/app/src/browser/paper-reed-update-feed.ts
new file mode 100644
index 0000000..163fdb8
--- /dev/null
+++ b/app/src/browser/paper-reed-update-feed.ts
@@ -0,0 +1,17 @@
+const GithubReleases = 'https://github.com/macopc/PaperReed/releases';
+const StableVersion = /^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$/;
+
+interface UpdateBuild {
+  packaged: boolean;
+  specMode: boolean;
+  platform: NodeJS.Platform;
+  arch: string;
+  version: string;
+}
+
+export function paperReedUpdateFeed({ packaged, specMode, platform, arch, version }: UpdateBuild) {
+  if (!packaged || specMode || !StableVersion.test(version)) return;
+  if (platform === 'darwin' && arch === 'arm64') {
+    return `${GithubReleases}/latest/download/Paper-Reed-update-stable-macos-arm64.json`;
+  }
+}
