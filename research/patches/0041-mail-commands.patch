+import React from 'react';
+export type MailCommand = { id: string; title: string; run: () => void; disabled?: boolean };
+export default class CommandPanel extends React.Component<{
+  commands: MailCommand[]; onClose: () => void;
+}, { query: string; index: number }> {
+  state = { query: '', index: 0 };
+  dialog: HTMLDialogElement;
+  componentDidMount() { this.dialog.showModal(); }
+  componentDidUpdate() { this.dialog.querySelector('.active')?.scrollIntoView({ block: 'nearest' }); }
+  componentWillUnmount() { this.dialog.close(); }
+  render() {
+    const commands = this.props.commands.filter(c =>
+      `${c.title} ${c.id}`.toLowerCase().includes(this.state.query.toLowerCase()));
+    const execute = (command: MailCommand) => {
+      if (!command || command.disabled) return;
+      this.props.onClose(); command.run();
+    };
+    return <dialog className="pr-command-panel" ref={el => this.dialog = el}
+      aria-label="命令面板" onCancel={event => { event.preventDefault(); this.props.onClose(); }}
+      onKeyDown={event => {
+        event.stopPropagation();
+        if (event.nativeEvent.isComposing) return;
+        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+          event.preventDefault(); this.setState({ index: Math.max(0, Math.min(commands.length - 1,
+            this.state.index + (event.key === 'ArrowDown' ? 1 : -1))) });
+        } else if (event.key === 'Enter' && event.target instanceof HTMLInputElement) {
+          event.preventDefault(); execute(commands[this.state.index]);
+        }
+      }}>
+      <header><span>跳转与操作</span><button aria-label="关闭命令面板" onClick={this.props.onClose}>Esc</button></header>
+      <input autoFocus aria-label="查找命令" placeholder="搜索操作、文件夹或设置…" value={this.state.query}
+        onChange={event => this.setState({ query: event.target.value, index: 0 })} />
+      <div className="pr-command-results">
+        {commands.map((command, index) => <button key={command.id} disabled={command.disabled}
+          className={index === this.state.index ? 'active' : ''} onClick={() => execute(command)}>
+          <span>{command.title}</span><kbd>{(AppEnv.keymaps.getBindingsForCommand(command.id) || [])
+            .slice(0, 1).join('').replace(/mod|command/g, '⌘')}</kbd>
+        </button>)}
+        {!commands.length && <p>没有匹配的操作</p>}
+      </div>
+      <footer>↑↓ 浏览 · Enter 执行 · Esc 关闭</footer>
+    </dialog>;
+  }
+}
