diff --git a/app/src/services/mail-core/draft-files.ts b/app/src/services/mail-core/draft-files.ts
index 6b2ed9d..ca1c4ee 100644
--- a/app/src/services/mail-core/draft-files.ts
+++ b/app/src/services/mail-core/draft-files.ts
@@ -51,3 +51,43 @@ export async function copyDraftFiles(files: File[]): Promise<File[]> {
     throw new Error(`attachment-copy-failed: ${error.message}`);
   }
 }
+
+// One startup sweep, not a background collector. Until restart, persisted drafts,
+// unsaved editors and send attempts may all own older copies of an attachment.
+export async function cleanupDraftFilesAtStartup() {
+  const { default: DatabaseStore } = await import('../../flux/stores/database-store');
+  const { default: DraftStore } = await import('../../flux/stores/draft-store');
+  const directory = path.join(AppEnv.getConfigDirPath(), 'files', 'lo', 'ca');
+  let candidates: string[];
+  try {
+    candidates = fs.readdirSync(directory, { withFileTypes: true })
+      .filter((entry) => entry.isDirectory() && /^local-[a-f0-9]{8}-[a-f0-9]{4}$/.test(entry.name))
+      .map((entry) => entry.name);
+  } catch (error) {
+    if (error.code === 'ENOENT') return 0;
+    throw error;
+  }
+  if (!candidates.length) return 0;
+  // One SQLite read snapshot includes queued drafts and unresolved sends. Preserve
+  // received-message references too, including drafts that were synchronized remotely.
+  const rows = await DatabaseStore._query(`SELECT lower(json_extract(f.value, '$.id')) AS id FROM Message m, json_each(m.data, '$.files') f
+    UNION SELECT lower(json_extract(f.value, '$.id')) FROM Task t, json_each(t.data, '$.draft.files') f
+      WHERE json_extract(t.data, '$.status') NOT IN ('complete','cancelled')
+    UNION SELECT lower(json_extract(f.value, '$.id')) FROM PaperReedSend s, json_each(s.payload, '$.draft.files') f
+      WHERE s.phase NOT IN ('accepted','rejected') OR (s.phase='accepted' AND s.sentCopy='pending')
+  `);
+  // A renderer reload with live composers is not an application startup.
+  const windows = require('@electron/remote').getGlobal('application').windowManager.getOpenWindows();
+  if (Object.keys(DraftStore._draftSessions).length || windows.some((w) => w.windowType === 'composer'))
+    return 0;
+  const referenced = new Set(rows.map((row) => row.id));
+  let removed = 0;
+  // No asynchronous gap between the ownership check and deletion. Only directories
+  // present before the database read are eligible; concurrent new imports are untouched.
+  for (const id of candidates) {
+    if (referenced.has(id)) continue;
+    fs.rmSync(path.join(directory, id), { recursive: true, force: true });
+    removed++;
+  }
+  return removed;
+}
