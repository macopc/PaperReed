+++ b/app/src/services/mail-core/index.ts
@@ -0,0 +1,137 @@
+import { createHash } from 'crypto';
+import DatabaseStore from '../../flux/stores/database-store';
+import TaskQueue from '../../flux/stores/task-queue';
+import { AccountStore } from '../../flux/stores/account-store';
+import { Message } from '../../flux/models/message';
+import { SyncbackDraftTask } from '../../flux/tasks/syncback-draft-task';
+import { SendDraftTask } from '../../flux/tasks/send-draft-task';
+import * as Actions from '../../flux/actions';
+
+export type Reference = { accountId: string; draftId: string };
+export type Access = {
+  check(accountId: string, action: 'read' | 'draft' | 'send'): void;
+  visible(draft: Message): Promise<boolean>;
+};
+export const desktopAccess: Access = {
+  check(accountId) {
+    if (!AccountStore.accountForId(accountId)) throw new Error('account-not-found');
+  },
+  visible: async () => true,
+};
+
+export function operationId(accountId: string, requestId: string) {
+  if (!accountId || !requestId || requestId.length > 200) throw new Error('invalid-request-id');
+  return 'pr-send-' + createHash('sha256').update(JSON.stringify([accountId, requestId])).digest('hex');
+}
+
+export async function getDraft(ref: Reference, access: Access) {
+  access.check(ref.accountId, 'read');
+  const draft = await DatabaseStore.findBy<Message>(Message, {
+    accountId: ref.accountId, headerMessageId: ref.draftId, draft: true,
+  }).include(Message.attributes.body);
+  if (!draft || !(await access.visible(draft))) throw new Error('draft-not-found');
+  access.check(ref.accountId, 'read');
+  if (typeof draft.body !== 'string') throw new Error('draft-body-not-cached');
+  return draft;
+}
+
+export function draftResult(draft: Message) {
+  return { accountId: draft.accountId, draftId: draft.headerMessageId, revision: draft.version,
+    subject: draft.subject, body: draft.body, plaintext: draft.plaintext,
+    to: draft.to, cc: draft.cc, bcc: draft.bcc };
+}
+
+// Desktop edits and external edits go through the same task and receipt check.
+export async function saveDraft(draft: Message, access: Access) {
+  access.check(draft.accountId, 'draft');
+  if (!(await access.visible(draft))) throw new Error('draft-not-found');
+  const task = new SyncbackDraftTask({ draft });
+  access.check(draft.accountId, 'draft');
+  Actions.queueTask(task);
+  const saved = await TaskQueue.waitForPerformLocal(task);
+  if (saved.error) throw new Error((saved.error as any).key || 'draft-save-failed');
+  saved.assertSaved();
+  return saved;
+}
+
+export async function updateDraft(ref: Reference, revision: number,
+  changes: { subject?: string; body?: string }, access: Access) {
+  const draft = await getDraft(ref, access);
+  access.check(ref.accountId, 'draft');
+  if (!Number.isSafeInteger(revision) || draft.version !== revision) throw new Error('draft-conflict');
+  // Text is already in the draft's format. No account, identity, attachments or
+  // bookkeeping fields can be overwritten through this small update interface.
+  if (changes.subject !== undefined) draft.subject = changes.subject;
+  if (changes.body !== undefined) draft.body = changes.body;
+  const saved = await saveDraft(draft, access);
+  draft.version = saved.savedDraftRevision;
+  draft.id = saved.savedDraftId;
+  return draftResult(draft);
+}
+
+async function ledger(accountId: string, id: string) {
+  const rows = await DatabaseStore._query(
+    'SELECT payload, phase, sentCopy FROM PaperReedSend WHERE accountId = ? AND requestId = ?',
+    [accountId, id]);
+  return rows[0];
+}
+
+async function checkRow(row: any, access: Access) {
+  const draft = new Message({}).fromJSON(JSON.parse(row.payload).draft);
+  access.check(draft.accountId, 'read');
+  if (!(await access.visible(draft))) throw new Error('operation-not-found');
+}
+
+function result(accountId: string, id: string, row: any) {
+  const draft = JSON.parse(row.payload).draft;
+  return { accountId, operationId: id, draftId: draft.hMsgId, revision: draft.v,
+    state: row.phase === 'attempting' ? 'running' : row.phase === 'rejected' ? 'failed' : row.phase,
+    sentCopy: row.sentCopy };
+}
+
+export async function getOperation(accountId: string, id: string, access: Access) {
+  access.check(accountId, 'read');
+  const row = await ledger(accountId, id);
+  if (row) { await checkRow(row, access); return result(accountId, id, row); }
+  const tasks = await DatabaseStore._query('SELECT data FROM Task WHERE accountId = ? AND id = ?', [accountId, id]);
+  if (!tasks.length) throw new Error('operation-not-found');
+  const task = JSON.parse(tasks[0].data);
+  if (task.__cls !== 'SendDraftTask') throw new Error('operation-not-found');
+  if (!(await access.visible(new Message({}).fromJSON(task.draft)))) throw new Error('operation-not-found');
+  access.check(accountId, 'read');
+  const state = task.error?.key === 'send-unknown' ? 'unknown' : task.error ? 'failed'
+    : task.status === 'cancelled' ? 'cancelled' : task.status === 'complete' ? 'unknown' : 'queued';
+  return { accountId, operationId: id, state, error: task.error || null };
+}
+
+export async function submitSend(ref: Reference, revision: number, requestId: string, access: Access) {
+  access.check(ref.accountId, 'send');
+  access.check(ref.accountId, 'read');
+  if (!Number.isSafeInteger(revision) || revision < 1) throw new Error('invalid-revision');
+  const id = operationId(ref.accountId, requestId);
+  const prior = await ledger(ref.accountId, id);
+  const match = (row: any) => {
+    const frozen = JSON.parse(row.payload).draft;
+    if (frozen.hMsgId !== ref.draftId || frozen.v !== revision) throw new Error('request-conflict');
+    return result(ref.accountId, id, row);
+  };
+  if (prior) { await checkRow(prior, access); return match(prior); } // Works even after the sent draft / Task was removed.
+  const draft = await getDraft(ref, access);
+  if (draft.version !== revision) throw new Error('draft-conflict');
+  const task = SendDraftTask.forSending(draft);
+  task.id = id;
+  access.check(ref.accountId, 'send');
+  if (typeof navigator !== 'undefined' && !navigator.onLine) throw new Error('offline');
+  Actions.queueTask(task);
+  // Admission, not delivery: network completion is queried by operation id.
+  let timer: ReturnType<typeof setTimeout>;
+  const admitted = await Promise.race([
+    TaskQueue.waitForPerformLocal(task),
+    new Promise<null>((resolve) => { timer = setTimeout(() => resolve(null), 5000); }),
+  ]).finally(() => clearTimeout(timer));
+  if (!admitted) return { accountId: ref.accountId, operationId: id, state: 'pending-admission', sentCopy: 'pending' };
+  const row = await ledger(ref.accountId, id);
+  if (row) return match(row); // Also checks a concurrent same-id/different-parameters race.
+  if (admitted.error) throw new Error((admitted.error as any).key || 'send-rejected');
+  throw new Error('send-admission-not-recorded');
+}
