diff --git a/app/internal_packages/onboarding/lib/paper-reed-icloud-page.tsx b/app/internal_packages/onboarding/lib/paper-reed-icloud-page.tsx
new file mode 100644
index 0000000..dafd4cf
--- /dev/null
+++ b/app/internal_packages/onboarding/lib/paper-reed-icloud-page.tsx
@@ -0,0 +1,238 @@
+import { shell } from 'electron';
+import React, { useEffect, useRef, useState } from 'react';
+import { Account, AccountStore, RegExpUtils } from 'mailspring-exports';
+import * as OnboardingActions from './onboarding-actions';
+import { addressWithLowercaseDomain, expandAccountForSetup, finalizeAndValidateAccount } from './onboarding-helpers';
+import OnboardingStore from './onboarding-store';
+
+const appleAccountURL = 'https://account.apple.com/';
+const fields = [
+  { key: 'name', id: 'name', title: '发件人姓名', autoComplete: 'name' },
+  { key: 'email', id: 'emailAddress', title: 'iCloud 邮件地址', inputMode: 'email', autoComplete: 'email' },
+  { key: 'password', id: 'settings.imap_password', title: '应用专用密码', type: 'password' },
+] as const;
+
+type Field = typeof fields[number]['key'];
+type Problem = { message: string; field?: Field };
+
+function connectionProblem(error: {
+  errorCode?: string;
+  errorService?: string;
+  errorAdvice?: string;
+  isNetworkError?: boolean;
+  certificates?: unknown[];
+}): Problem {
+  if (error.errorAdvice || error.certificates?.length || error.errorCode === 'ErrorCertificate' ||
+      ['ErrorTLSNotAvailable', 'ErrorStartTLSNotAvailable'].includes(error.errorCode)) {
+    return { message: '无法建立安全连接。请检查系统时间和网络设置后重试。' };
+  }
+  if (error.isNetworkError) return { message: '网络连接中断。请检查网络后重试。' };
+  switch (error.errorCode) {
+    case 'ErrorAuthentication':
+    case 'ErrorAuthenticationRequired':
+      return {
+        field: 'password',
+        message: error.errorService === 'smtp'
+          ? 'iCloud 发信服务器拒绝了登录。请核对邮件地址，并生成新的应用专用密码后重试。'
+          : 'iCloud 拒绝了登录。请核对邮件地址，并生成新的应用专用密码后重试。',
+      };
+    case 'ErrorNeedsConnectToWebmail':
+      return { message: '请先在 iCloud 网页版确认邮件已开通，再回来连接。' };
+    case 'ErrorInvalidAccount':
+      return { message: '无法读取 iCloud 收件箱。请在 iCloud 网页版确认收件箱可用，再回来重试。' };
+    case 'ErrorConnection':
+      return { message: '暂时无法连接 iCloud 邮件服务器。请检查网络，或稍后重试。' };
+    default:
+      return { message: '未能连接 iCloud 邮件。请重试。' };
+  }
+}
+
+export default function PaperReedICloudPage({ account, isCurrentVisit }: {
+  account: Account;
+  isCurrentVisit?: () => boolean;
+}) {
+  const [values, setValues] = useState({
+    name: account.name || '',
+    email: account.emailAddress || '',
+    password: account.settings.imap_password || '',
+  });
+  const [problem, setProblem] = useState<Problem>();
+  const [guideFailed, setGuideFailed] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const form = useRef<HTMLFormElement>(null);
+  const submitButton = useRef<HTMLButtonElement>(null);
+  const errorMessage = useRef<HTMLParagraphElement>(null);
+  const submitting = useRef(false);
+  const guideRequest = useRef(0);
+  const current = () => isCurrentVisit?.() !== false;
+  const focusField = (field: Field) => {
+    (form.current?.elements.namedItem(field) as HTMLInputElement | null)?.focus();
+  };
+
+  useEffect(() => {
+    const firstEmpty = fields.find(({ key }) => !values[key]);
+    focusField(firstEmpty?.key || 'name');
+  }, []);
+
+  useEffect(() => {
+    const message = errorMessage.current;
+    if (problem && message && message.getBoundingClientRect().bottom > window.innerHeight) {
+      message.scrollIntoView({ block: 'nearest' });
+    }
+  }, [problem]);
+
+  const openPasswordGuide = async (event: React.MouseEvent<HTMLAnchorElement>) => {
+    event.preventDefault();
+    const request = ++guideRequest.current;
+    setGuideFailed(false);
+    try {
+      await shell.openExternal(appleAccountURL);
+    } catch {
+      if (current() && request === guideRequest.current) setGuideFailed(true);
+    }
+  };
+
+  const connect = async (advanced = false) => {
+    if (submitting.current || !current()) return;
+    guideRequest.current++;
+    setGuideFailed(false);
+    const name = values.name.trim();
+    const typedAddress = values.email.trim();
+    const password = values.password.trim();
+    const invalid = ([
+      { field: 'name', valid: !!name, message: '请填写发件人姓名。' },
+      { field: 'email', valid: RegExpUtils.emailRegex({ matchTailOfString: true }).exec(typedAddress)?.[0] === typedAddress,
+        message: '请填写完整的 iCloud 邮件地址。' },
+      { field: 'password', valid: !!password, message: '请填写 Apple 账户的应用专用密码。' },
+    ] as const).find(candidate => !candidate.valid);
+    if (invalid) {
+      setProblem(invalid);
+      focusField(invalid.field);
+      return;
+    }
+
+    const { account: existing, ambiguous } = OnboardingStore.rememberICloudAccount(typedAddress);
+    if (ambiguous) {
+      setProblem({ field: 'email', message: '此地址匹配到多个账号。请按邮箱账号设置中显示的大小写填写。' });
+      focusField('email');
+      return;
+    }
+    if (existing && !AccountStore.accountForId(existing.id)) {
+      setProblem({ field: 'email', message: '此邮箱账号已移除。请返回邮箱选择后重新添加，或填写另一个邮箱。' });
+      focusField('email');
+      return;
+    }
+    setProblem(undefined);
+    submitting.current = true;
+    setBusy(true);
+    if (!advanced) submitButton.current?.focus();
+    try {
+      const entered = new Account({
+        name, emailAddress: existing?.emailAddress ?? addressWithLowercaseDomain(typedAddress), provider: 'icloud',
+        settings: {
+          imap_password: password,
+          smtp_verification: 'login',
+          create_helper_folders: existing?.settings.create_helper_folders ?? false,
+        },
+      });
+      const { account: expanded } = await expandAccountForSetup(entered);
+      if (!current()) return;
+      if (existing?.settings.container_folder !== undefined) {
+        expanded.settings.container_folder = existing.settings.container_folder;
+      }
+
+      let draft = expanded;
+      if (account.emailAddress === expanded.emailAddress) {
+        const { imap_password, smtp_password, ...serverSettings } = account.settings;
+        draft = expanded.clone();
+        draft.settings = {
+          ...expanded.settings,
+          ...serverSettings,
+          smtp_password: smtp_password === imap_password ? password : smtp_password,
+        };
+      }
+      // Keep the same mailbox's server draft available while direct validation uses Apple's preset.
+      OnboardingActions.setAccount(draft);
+      if (advanced) {
+        OnboardingActions.moveToPage('account-settings-imap', existing);
+        return;
+      }
+      const validated = await finalizeAndValidateAccount(expanded, existing?.id);
+      if (current()) OnboardingActions.finishAndAddAccount(validated, existing);
+    } catch (error) {
+      if (!current()) return;
+      const next = connectionProblem(error || {});
+      setProblem(next);
+      if (next.field && document.activeElement === submitButton.current) focusField(next.field);
+    } finally {
+      if (current()) {
+        submitting.current = false;
+        setBusy(false);
+      }
+    }
+  };
+
+  return (
+    <div className="page account-setup pr-icloud-setup">
+      <div className="pr-onboarding-brand">Paper Reed</div>
+      <section className="pr-icloud-content" aria-labelledby="pr-icloud-heading">
+        <h2 id="pr-icloud-heading">连接 iCloud 邮件</h2>
+        <form ref={form} noValidate onSubmit={event => { event.preventDefault(); void connect(); }}
+          onKeyDown={event => {
+            if (event.repeat && event.key === 'Enter') event.preventDefault();
+          }}>
+          {fields.map(({ key, id, title, ...attrs }) => (
+            <div className="pr-icloud-field" key={key}>
+              <label htmlFor={id}>{title}</label>
+              <input
+                {...attrs}
+                id={id}
+                name={key}
+                value={values[key]}
+                required
+                readOnly={busy}
+                spellCheck={false}
+                autoCapitalize={key === 'name' ? 'words' : 'none'}
+                aria-invalid={problem?.field === key || undefined}
+                aria-describedby={key === 'password'
+                  ? `pr-icloud-password-help${problem?.field === key ? ' pr-icloud-error' : ''}`
+                  : problem?.field === key ? 'pr-icloud-error' : undefined}
+                onChange={e => {
+                  const { value } = e.currentTarget;
+                  if (key === 'email' && current()) OnboardingStore.rememberICloudAccount(value.trim());
+                  setValues(previous => ({ ...previous, [key]: value }));
+                  if (problem?.field === key || (key === 'email' && problem?.field === 'password')) {
+                    setProblem(undefined);
+                  }
+                }}
+              />
+            </div>
+          ))}
+          <p id="pr-icloud-password-help">
+            在 Apple 账户的「登录与安全」中生成应用专用密码，需开启双重认证。
+            <a className="no-open-link-events" href={appleAccountURL} onKeyDown={event => {
+              if (event.key === 'Enter') {
+                if (event.repeat) event.preventDefault();
+                event.stopPropagation();
+              }
+            }} onClick={openPasswordGuide}>前往 Apple 账户<span aria-hidden="true"> ↗</span></a>
+            <span className="pr-icloud-guide-error" role="alert">
+              {guideFailed && '无法打开浏览器。请在浏览器中访问 account.apple.com。'}
+            </span>
+          </p>
+          <div className="pr-icloud-actions">
+            <button className="btn btn-add-account" type="submit" ref={submitButton} aria-disabled={busy}>
+              连接邮箱
+            </button>
+            <button className="btn pr-icloud-advanced" type="button" aria-disabled={busy}
+              onClick={() => void connect(true)}>
+              服务器设置…
+            </button>
+          </div>
+          <div role="status" className="pr-icloud-status">{busy && '正在验证 iCloud 邮件连接…'}</div>
+          <p id="pr-icloud-error" role="alert" ref={errorMessage}>{problem?.message}</p>
+        </form>
+      </section>
+    </div>
+  );
+}
