@@ -0,0 +1,308 @@
+import { createHash } from 'crypto';
+import {
+  AccountStore,
+  Actions,
+  CategoryStore,
+  DatabaseStore,
+  Message,
+  Thread,
+} from 'mailspring-exports';
+import { Task } from '../../flux/tasks/task';
+import { ChangeMailTask } from '../../flux/tasks/change-mail-task';
+import { ChangeFolderTask } from '../../flux/tasks/change-folder-task';
+import { ChangeUnreadTask } from '../../flux/tasks/change-unread-task';
+import { Folder } from '../../flux/models/folder';
+import {
+  Grant,
+  FULL_GRANT,
+  isThreadAllowed,
+  isMessageAllowed,
+  isFolderAllowed,
+} from '../mail-access/grant';
+import { threadQuery } from '../mail-access/queries';
+
+export type MailAction = 'read' | 'unread' | 'archive' | 'spam' | 'trash' | 'inbox';
+export type MailTarget = { accountId: string; threadId: string };
+export type MailReceipt = MailTarget & {
+  taskId?: string;
+  status: string;
+  undoable?: boolean;
+  error?: string;
+};
+export type InboxAccess = {
+  grant: () => Grant;
+  check: (accountId: string, write: boolean) => void;
+};
+export const inboxDesktopAccess: InboxAccess = {
+  grant: () => FULL_GRANT,
+  check(accountId) {
+    if (!AccountStore.accountForId(accountId)) throw new Error('account-not-found');
+  },
+};
+
+// Both callers use the same existing parser / database query. No second search index.
+export async function queryInbox(
+  input: {
+    accountIds: string[];
+    query?: string;
+    folder?: string;
+    unread?: boolean;
+    limit: number;
+    offset?: number;
+  },
+  access: InboxAccess
+) {
+  const grant = access.grant();
+  input.accountIds.forEach((id) => access.check(id, false));
+  const ids = input.accountIds.filter(
+    (id) => grant.accountIds === null || grant.accountIds.includes(id)
+  );
+  const clauses: any[] = [];
+  if (input.folder) clauses.push({ in: input.folder });
+  if (input.unread) clauses.push({ unread: true });
+  const query = threadQuery(
+    { ...grant, accountIds: ids },
+    {
+      search: input.query,
+      filter: clauses.length ? { and: clauses } : undefined,
+      limit: Math.min(input.limit, 201),
+      offset: input.offset || 0,
+      background: true,
+    }
+  );
+  const rows = await query;
+  input.accountIds.forEach((id) => access.check(id, false));
+  return rows.filter((t) => isThreadAllowed(access.grant(), t));
+}
+function taskId(accountId: string, requestId: string, threadId: string) {
+  return (
+    'pr-mail-' +
+    createHash('sha256')
+      .update(JSON.stringify([accountId, requestId, threadId]))
+      .digest('hex')
+  );
+}
+function taskState(task: ChangeMailTask): string {
+  if (task.error) return 'failed';
+  if (task.status === Task.Status.Cancelled) return 'cancelled';
+  if (task.status === Task.Status.Complete) return 'succeeded';
+  return task.status === Task.Status.Remote ? 'syncing' : 'queued';
+}
+function receipt(task: ChangeMailTask): MailReceipt {
+  pending.delete(task.id + ':' + task.paperReed.action);
+  pending.delete(task.id + ':undo');
+  const status = taskState(task);
+  return {
+    accountId: task.accountId,
+    threadId: task.paperReed.threadId,
+    taskId: task.id,
+    status,
+    undoable: status === 'succeeded' && !task.isUndo && task.paperReed.undoable,
+    ...(task.error
+      ? { error: typeof task.error === 'string' ? task.error : JSON.stringify(task.error) }
+      : {}),
+  };
+}
+async function taskFor(accountId: string, id: string, access: InboxAccess, write = false) {
+  access.check(accountId, write);
+  const task = await DatabaseStore.find<ChangeMailTask>(Task, id);
+  if (!task || task.accountId !== accountId || !task.paperReed)
+    throw new Error('operation-not-found');
+  const messages = await DatabaseStore.findAll<Message>(Message).where(
+    Message.attributes.id.in(task.messageIds)
+  );
+  if (messages.some((m) => !isMessageAllowed(access.grant(), m)))
+    throw new Error('Access denied: excluded mail');
+  access.check(accountId, write);
+  return task;
+}
+export async function mailTaskStatus(
+  ref: { accountId: string; taskId: string },
+  access: InboxAccess
+) {
+  const task = await taskFor(ref.accountId, ref.taskId, access);
+  const result = receipt(task);
+  if (result.undoable && (await DatabaseStore.find(Task, taskId(task.accountId, 'undo', task.id))))
+    result.undoable = false;
+  access.check(ref.accountId, false);
+  return result;
+}
+const pending = new Map<string, Promise<MailReceipt>>();
+async function queued(task: ChangeMailTask) {
+  task.canBeUndone = false; // Exact undo below; do not also offer the upstream approximate/global undo.
+  task.willBeQueued();
+  Actions.queueTask(task);
+  return {
+    accountId: task.accountId,
+    threadId: task.paperReed.threadId,
+    taskId: task.id,
+    status: 'queued',
+  };
+}
+export function actionAvailable(action: MailAction, accountId: string) {
+  if (action === 'read' || action === 'unread') return true;
+  // This first adapter uses folder placements. Label-only Inbox archives need an exact label snapshot.
+  if (action === 'archive')
+    return (
+      CategoryStore.getInboxCategory(accountId) instanceof Folder &&
+      CategoryStore.getArchiveCategory(accountId) instanceof Folder
+    );
+  return CategoryStore.getCategoryByRole(accountId, action) instanceof Folder;
+}
+export async function organizeMail(
+  input: { action: MailAction; targets: MailTarget[]; requestId: string },
+  access: InboxAccess
