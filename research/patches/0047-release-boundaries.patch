@@ -0,0 +1,82 @@
+import { safeStorage } from 'electron';
+
+export type KeySet = Record<string, string>;
+export type CredentialChange = { set?: KeySet; remove?: string[]; removePrefix?: string };
+
+export const secureStorage = {
+  isAvailable: () => safeStorage.isAsyncEncryptionAvailable(),
+  encrypt: (text: string) => safeStorage.encryptStringAsync(text),
+  decrypt: (bytes: Buffer) => safeStorage.decryptStringAsync(bytes),
+  decryptLegacy: (bytes: Buffer) => safeStorage.decryptString(bytes),
+};
+
+// One instance in the main process owns the whole keyset, including migration writes.
+// Queue failures propagate to their caller without stopping later requests.
+export class CredentialStore {
+  private pending: Promise<unknown> = Promise.resolve();
+  private reEncryptAttempted = false;
+  constructor(
+    private config: { get(key: string): any; set(key: string, value: any): void },
+    private storage = secureStorage
+  ) {}
+
+  private serial<T>(fn: () => Promise<T>): Promise<T> {
+    const result = this.pending.then(fn);
+    this.pending = result.catch(() => {});
+    return result;
+  }
+
+  read(): Promise<KeySet> {
+    return this.serial(() => this.readKeys());
+  }
+
+  update(change: CredentialChange): Promise<void> {
+    return this.serial(async () => {
+      if (change.removePrefix !== undefined && !change.removePrefix)
+        throw new Error('Credential removal requires a non-empty prefix.');
+      const keys = await this.readKeys();
+      Object.assign(keys, change.set);
+      for (const key of change.remove || []) delete keys[key];
+      if (change.removePrefix)
+        for (const key of Object.keys(keys))
+          if (key.startsWith(change.removePrefix)) delete keys[key];
+      await this.writeKeys(keys);
+    });
+  }
+
+  private async readKeys(): Promise<KeySet> {
+    const value = this.config.get('credentials');
+    if (value === undefined || value === null || value === 'null') return {};
+    const bytes = Buffer.from(value, 'utf8');
+    let decoded: { result: string; shouldReEncrypt: boolean };
+    try {
+      decoded = await this.storage.decrypt(bytes);
+    } catch {
+      // Existing pre-1.24 blobs use the synchronous keychain identity on some platforms.
+      // If both fail, propagate; never overwrite an unreadable keyset with an empty one.
+      decoded = { result: this.storage.decryptLegacy(bytes), shouldReEncrypt: true };
+    }
+    const keys = JSON.parse(decoded.result) as KeySet;
+    if (decoded.shouldReEncrypt && !this.reEncryptAttempted) {
+      this.reEncryptAttempted = true;
+      try {
+        await this.writeKeys(keys);
+      } catch {
+        // Successfully read credentials remain usable if an optional migration fails.
+        console.warn('Could not migrate saved credentials to the current keychain provider.');
+      }
+    }
+    return keys;
+  }
+
+  private async writeKeys(keys: KeySet) {
+    if (!(await this.storage.isAvailable()))
+      throw new Error(
+        'Secure credential storage is unavailable. Unlock your system keychain and restart.'
+      );
+    const bytes = await this.storage.encrypt(JSON.stringify(keys));
+    if (process.platform === 'linux' && bytes.subarray(0, 3).toString() === 'v10')
+      throw new Error('The desktop keyring is unavailable; refusing the plaintext fallback key.');
+    this.config.set('credentials', bytes);
+  }
+}
