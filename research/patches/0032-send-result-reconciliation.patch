+    void reconcileSentCopies(const std::string & account) {
+        SQLite::Statement q(db, R"SQL(
+            UPDATE PaperReedSend SET sentCopy='filed'
+            WHERE accountId=? AND phase='accepted' AND sentCopy='pending'
+              AND EXISTS (
+                SELECT 1 FROM Message m
+                WHERE m.accountId=PaperReedSend.accountId AND m.draft=0
+                  AND (CASE WHEN substr(sentIdentity,1,6)='gmail:'
+                       THEN m.gMsgId=substr(sentIdentity,7)
+                       ELSE m.headerMessageId=COALESCE(sentIdentity,json_extract(payload,'$.draft.hMsgId')) END)
+                  AND (EXISTS (SELECT 1 FROM json_each(m.data,'$.labels') l WHERE l.value='\Sent')
+                       OR EXISTS (SELECT 1 FROM MessageFolder p JOIN Folder f ON f.id=p.folderId
+                                  WHERE p.messageId=m.id AND p.remoteUID>0 AND json_extract(f.data,'$.role')='sent'))
+              )
+        )SQL");
+        q.bind(1, account); q.exec();
+    }
