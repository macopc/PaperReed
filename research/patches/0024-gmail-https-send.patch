+// Gmail requests deliberately make one attempt. A lost send response is not safe to retry.
+static string gmailEndpoint(const string & env, const string & fallback) {
+    string value = MailUtils::getEnvUTF8(env.c_str());
+    return value.empty() ? fallback : value;
+}
+
+static json gmailRequest(const string & url, const string & method, const string & token,
+                         const string & body, bool form = false, bool sending = false) {
+    CURL * handle = CreateJSONRequest(url, method, token.empty() ? "" : "Bearer " + token);
+    if (!body.empty()) {
+        CurlRequestData * data = nullptr;
+        curl_easy_getinfo(handle, CURLINFO_PRIVATE, &data);
+        data->headers = curl_slist_append(data->headers, form ? "Content-Type: application/x-www-form-urlencoded" : "Content-Type: application/json");
+        curl_easy_setopt(handle, CURLOPT_HTTPHEADER, data->headers);
+        curl_easy_setopt(handle, CURLOPT_POSTFIELDS, body.c_str());
+    }
+    curl_easy_setopt(handle, CURLOPT_TIMEOUT, 60);
+    string response;
+    curl_easy_setopt(handle, CURLOPT_WRITEFUNCTION, _onAppendToString);
+    curl_easy_setopt(handle, CURLOPT_WRITEDATA, &response);
+    CURLcode result = curl_easy_perform(handle);
+    long status = 0;
+    curl_easy_getinfo(handle, CURLINFO_RESPONSE_CODE, &status);
+    CleanupCurlRequest(handle);
+    if (result != CURLE_OK) {
+        throw SyncException(sending ? "send-unknown" : "gmail-authorization-failed",
+                            "Google HTTPS transport failed: " + string(curl_easy_strerror(result)), false);
+    }
+    if (status < 200 || status >= 300) {
+        bool rejected = status >= 400 && status < 500;
+        throw SyncException(sending ? (rejected ? "send-rejected" : "send-unknown") : "gmail-authorization-failed",
+                            "Google HTTPS returned HTTP " + to_string(status), false);
+    }
+    return json::parse(response, nullptr, false);
+}
+
+string GmailSendAccessToken(shared_ptr<Account> account) {
+    string body = "grant_type=refresh_token&client_id=" + URLEscape(account->gmailSetting("gmail_client_id")) +
+        "&client_secret=" + URLEscape(account->gmailSetting("gmail_client_secret")) +
+        "&refresh_token=" + URLEscape(account->gmailSetting("gmail_refresh_token"));
+    auto response = gmailRequest(gmailEndpoint("GMAIL_OAUTH_TOKEN_URL", "https://oauth2.googleapis.com/token"), "POST", "", body, true);
+    string token = JSONString(response, "access_token");
+    if (token.empty()) throw SyncException("gmail-authorization-failed", "Google returned no access token. Reauthorize Gmail sending.", false);
+    return token;
+}
+
+void ValidateGmailSendAuthorization(shared_ptr<Account> account) {
+    string token = GmailSendAccessToken(account);
+    auto identity = gmailRequest(gmailEndpoint("GMAIL_USERINFO_URL", "https://openidconnect.googleapis.com/v1/userinfo"), "GET", token, "");
+    string email = JSONString(identity, "email");
+    string expected = account->emailAddress();
+    transform(email.begin(), email.end(), email.begin(), ::tolower);
+    transform(expected.begin(), expected.end(), expected.begin(), ::tolower);
+    if (email != expected || !identity.is_object() || identity.value("email_verified", false) != true) {
+        throw SyncException("gmail-authorization-failed", "Google authorization belongs to a different mailbox. Reauthorize Gmail sending.", false);
+    }
+}
+
+string SendGmailMessage(const string & accessToken, const string & base64urlMIME) {
+    auto response = gmailRequest(gmailEndpoint("GMAIL_API_URL", "https://gmail.googleapis.com/gmail/v1") + "/users/me/messages/send",
+                                 "POST", accessToken, json({{"raw", base64urlMIME}}).dump(), false, true);
+    string id = JSONString(response, "id");
+    if (id.empty()) {
+        throw SyncException("send-unknown", "Google returned no message receipt. Check Sent before retrying.", false);
+    }
+    return id;
+}
+
