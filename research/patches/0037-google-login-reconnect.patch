+// Reconnect keeps account identity and local metadata; authorization alone never persists it.
+export async function buildPaperReedGmailAccount(
+  authorization: { emailAddress: string; settings: Pick<Account['settings'], 'gmail_api_send' | 'gmail_client_id' | 'gmail_client_secret' | 'refresh_token'> },
+  existing?: Account
+) {
+  const account = existing ? existing.clone() : new Account({
+    name: authorization.emailAddress.split('@')[0], emailAddress: authorization.emailAddress, settings: {},
+  });
+  account.provider = 'gmail';
+  account.settings = {
+    ...account.settings,
+    imap_host: 'imap.gmail.com', imap_port: 993, imap_security: 'SSL / TLS',
+    imap_username: account.emailAddress, imap_allow_insecure_ssl: false,
+    smtp_host: 'smtp.gmail.com', smtp_port: 465, smtp_security: 'SSL / TLS',
+    smtp_username: account.emailAddress, smtp_allow_insecure_ssl: false,
+    create_helper_folders: false,
+    ...authorization.settings,
+  };
+  delete account.settings.imap_password;
+  delete account.settings.smtp_password;
+  delete account.settings.gmail_refresh_token;
+  return finalizeAndValidateAccount(account, existing?.id);
+}
