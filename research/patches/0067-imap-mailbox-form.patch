diff --git a/app/internal_packages/onboarding/lib/paper-reed-imap-page.tsx b/app/internal_packages/onboarding/lib/paper-reed-imap-page.tsx
new file mode 100644
index 0000000..41cd363
--- /dev/null
+++ b/app/internal_packages/onboarding/lib/paper-reed-imap-page.tsx
@@ -0,0 +1,177 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { Account, RegExpUtils } from 'mailspring-exports';
+import * as OnboardingActions from './onboarding-actions';
+import { expandAccountForSetup } from './onboarding-helpers';
+
+const fields = [
+  { key: 'name', id: 'name', label: '发件人姓名', autoComplete: 'name' },
+  { key: 'email', id: 'emailAddress', label: '邮箱地址', type: 'email', autoComplete: 'email' },
+  { key: 'password', id: 'settings.imap_password', label: '密码或应用专用密码', type: 'password' },
+] as const;
+type Field = typeof fields[number]['key'];
+type Problem = { field?: Field; message: string };
+
+export default function PaperReedIMAPPage({ account, confirmServers, isCurrentVisit }: {
+  account: Account;
+  confirmServers?: boolean;
+  isCurrentVisit?: () => boolean;
+}) {
+  const [values, setValues] = useState({
+    name: account.name || '',
+    email: account.emailAddress || '',
+    password: account.settings.imap_password || '',
+  });
+  const [searching, setSearching] = useState(false);
+  const [problem, setProblem] = useState<Problem>();
+  const form = useRef<HTMLFormElement>(null);
+  const errorMessage = useRef<HTMLParagraphElement>(null);
+  const pending = useRef(false);
+  const email = values.email.trim();
+  const validEmail = RegExpUtils.emailRegex({ matchTailOfString: true, allowPunycodeTLD: true })
+    .exec(email)?.[0] === email;
+  const google = validEmail && /@(gmail|googlemail)\.com$/i.test(email);
+  const current = () => isCurrentVisit?.() !== false;
+  const focusField = (field: Field) =>
+    (form.current?.elements.namedItem(field) as HTMLInputElement | null)?.focus();
+
+  useEffect(() => {
+    const firstEmpty = fields.find(({ key }) => !values[key] && (!google || key !== 'password'));
+    focusField(firstEmpty?.key || 'name');
+  }, []);
+
+  useEffect(() => {
+    const message = errorMessage.current;
+    if (problem && message && message.getBoundingClientRect().bottom > window.innerHeight) {
+      message.scrollIntoView({ block: 'nearest' });
+    }
+  }, [problem]);
+
+  const continueSetup = async (manual = false) => {
+    if (!current() || (pending.current && !manual)) return;
+    const name = values.name.trim();
+    const { password } = values;
+    const invalid = ([
+      { field: 'name', missing: !google && !name, message: '请填写发件人姓名。' },
+      { field: 'email', missing: !validEmail, message: '请填写完整的邮箱地址。' },
+      { field: 'password', missing: !google && !password, message: '请填写邮箱密码或应用专用密码。' },
+    ] as const).find(field => field.missing);
+    if (invalid) {
+      setProblem(invalid);
+      focusField(invalid.field);
+      return;
+    }
+
+    // Only the manual path reuses its draft. Discovery supplies its own server parameters.
+    const reuseDraft = manual && email === account.emailAddress;
+    const entered = reuseDraft
+      ? account.clone()
+      : new Account({ emailAddress: email, provider: 'imap', settings: {} });
+    entered.name = name;
+    if (entered.settings.smtp_password === entered.settings.imap_password) {
+      entered.settings.smtp_password = password;
+    }
+    entered.settings.imap_password = password;
+    if (google) {
+      OnboardingActions.setAccount(entered);
+      OnboardingActions.moveToPage('paper-reed-google');
+      return;
+    }
+
+    setProblem(undefined);
+    if (!manual) {
+      pending.current = true;
+      setSearching(true);
+    }
+    try {
+      const expanded = manual ? { account: entered, confirmServers: false } : await expandAccountForSetup(entered);
+      if (!current()) return;
+      const draft = expanded.account;
+      draft.settings = {
+        imap_username: draft.emailAddress,
+        smtp_username: draft.emailAddress,
+        smtp_password: draft.settings.imap_password,
+        imap_port: 993,
+        smtp_port: 465,
+        imap_security: 'SSL / TLS',
+        smtp_security: 'SSL / TLS',
+        imap_allow_insecure_ssl: false,
+        smtp_allow_insecure_ssl: false,
+        container_folder: '',
+        create_helper_folders: false,
+        smtp_verification: 'login',
+        ...draft.settings,
+      };
+      OnboardingActions.setAccount(draft, {
+        confirmServers: expanded.confirmServers || (reuseDraft && confirmServers),
+      });
+      OnboardingActions.moveToPage('account-settings-imap');
+    } catch {
+      if (current()) setProblem({ message: '未能查找邮件服务器。请重试，或手动填写服务器。' });
+    } finally {
+      if (current()) {
+        pending.current = false;
+        setSearching(false);
+      }
+    }
+  };
+
+  return (
+    <div className="page account-setup AccountBasicSettingsForm pr-imap-setup">
+      <div className="pr-onboarding-brand">Paper Reed</div>
+      <section className="pr-imap-content" aria-labelledby="pr-imap-heading">
+        <h2 id="pr-imap-heading">连接其他邮箱</h2>
+        <form ref={form} noValidate onSubmit={event => { event.preventDefault(); void continueSetup(); }}
+          onKeyDown={event => {
+            if (event.repeat && event.key === 'Enter') event.preventDefault();
+          }}>
+          {fields.filter(({ key }) => !google || key !== 'password').map(({ key, id, label, ...attrs }) => {
+            const invalid = problem?.field === key;
+            const help = key === 'password' ? 'pr-imap-help' : '';
+            return (
+              <div className="pr-imap-field" key={key}>
+                <label htmlFor={id}>{label}</label>
+                <input
+                  {...attrs}
+                  id={id}
+                  name={key}
+                  value={values[key]}
+                  required={!google || key === 'email'}
+                  readOnly={searching}
+                  spellCheck={false}
+                  autoCapitalize={key === 'name' ? 'words' : 'none'}
+                  aria-invalid={invalid || undefined}
+                  aria-describedby={[help, invalid ? 'pr-imap-error' : ''].filter(Boolean).join(' ') || undefined}
+                  onChange={event => {
+                    const { value } = event.currentTarget;
+                    setValues(previous => ({ ...previous, [key]: value }));
+                    if (!problem?.field || problem.field === key || key === 'email') {
+                      setProblem(undefined);
+                    }
+                  }}
+                />
+              </div>
+            );
+          })}
+          <p id="pr-imap-help">
+            {google
+              ? '此邮箱通过 Google 登录连接，无需填写密码。'
+              : '如果服务商要求，请使用应用专用密码。下一步会查找收信与发信服务器。'}
+          </p>
+          <div className="pr-imap-actions">
+            {google ? (
+              <button className="btn btn-add-account" type="submit" data-use-google>使用 Google 登录</button>
+            ) : (
+              <>
+                <button className="btn btn-add-account" type="submit" aria-disabled={searching}>下一步</button>
+                <button className="btn pr-imap-manual" type="button" data-manual-setup
+                  onClick={() => void continueSetup(true)}>手动填写服务器</button>
+              </>
+            )}
+          </div>
+          <div role="status" className="pr-imap-status">{searching && '正在查找邮件服务器…'}</div>
+          <p id="pr-imap-error" role="alert" ref={errorMessage}>{problem?.message}</p>
+        </form>
+      </section>
+    </div>
+  );
+}
