+static string GoogleMailboxKey(string email) {
+    transform(email.begin(), email.end(), email.begin(), [](unsigned char c) { return std::tolower(c); });
+    static const std::regex personal(R"(([a-z0-9.]+)(?:\+[^@\s]+)?@(?:gmail\.com|googlemail\.com))");
+    std::smatch match;
+    if (!std::regex_match(email, match, personal)) return email;
+
+    string username = match[1].str();
+    username.erase(remove(username.begin(), username.end(), '.'), username.end());
+    return username + "@gmail.com";
