+// Recovery copies get a new identity; they never overwrite or send the source draft.
+export async function saveDraftCopy(source: Message, access: Access) {
+  access.check(source.accountId, 'draft');
+  if (!(await access.visible(source))) throw new Error('draft-not-found');
+  if (source.files.length) throw new Error('Recovery copies with attachments are not supported yet. Keep this window open.');
+  const copy = new Message({
+    accountId: source.accountId,
+    headerMessageId: `${randomUUID().toUpperCase()}@getmailspring.com`,
+    version: 0, draft: true, pristine: false, unread: false, starred: false,
+    date: new Date(), from: source.from, to: source.to, cc: source.cc, bcc: source.bcc,
+    replyTo: source.replyTo, replyToHeaderMessageId: source.replyToHeaderMessageId,
+    forwardedHeaderMessageId: source.forwardedHeaderMessageId,
+    subject: source.subject, body: source.body, plaintext: source.plaintext,
+  });
+  const saved = await saveDraft(copy, access);
+  copy.id = saved.savedDraftId;
+  copy.version = saved.savedDraftRevision;
+  return copy;
 }
 
