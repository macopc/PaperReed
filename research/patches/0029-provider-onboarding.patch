diff --git a/app/internal_packages/onboarding/lib/paper-reed-microsoft-page.tsx b/app/internal_packages/onboarding/lib/paper-reed-microsoft-page.tsx
new file mode 100644
index 0000000..63c2438
--- /dev/null
