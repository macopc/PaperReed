+void TaskProcessor::performLocalSendDraft(Task * task) {
+    MailStoreTransaction transaction{store, "performLocalSendDraft"};
+    PaperReed::MailMutationGuard guard(store->db());
+    auto & data = task->data();
+    // The ledger is engine-owned. Never trust caller-supplied execution markers.
+    data.erase("_performRemoteRan");
+    data.erase("sendOutcome");
+    data.erase("sentCopy");
+    json payload = {{"draft", data["draft"]}, {"perRecipientBodies", data["perRecipientBodies"]}};
+    guard.admit(account->id(), task->id(), data["draft"], payload);
+    task->setStatus("remote");
+    store->save(task);
+    transaction.commit();
+}
