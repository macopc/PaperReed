+  enabled: boolean;
+};
+async function storedRules(accountId: string): Promise<LocalRule[]> {
+  await ensureLocalTriage();
+  return (
+    await sql('SELECT * FROM PaperReedLocalRule WHERE accountId=? ORDER BY position,id', [
+      accountId,
+    ])
+  ).map((r) => ({ ...r, enabled: !!r.enabled }));
+}
+const revisionOf = (rules: LocalRule[]) =>
+  createHash('sha256').update(JSON.stringify(rules)).digest('hex');
+function ruleAccess(accountId: string, access: InboxAccess) {
+  access.check(accountId, true);
+  if (access.grant().excludedFolderIds[accountId]?.length)
+    throw new Error('Access denied: account-wide rules require all folders');
+}
+export async function listLocalRules(accountId: string, access: InboxAccess) {
+  access.check(accountId, false);
+  const rules = await storedRules(accountId);
+  const folders = await sql('SELECT id,data FROM Folder WHERE accountId=?', [accountId]);
+  access.check(accountId, false);
+  return {
+    revision: revisionOf(rules),
+    rules: rules.map((r) => {
+      const baseline = r.baseline && JSON.parse(r.baseline);
+      const folder = baseline && folders.find((f) => f.id === baseline.folderId);
+      const status =
+        folder && JSON.parse(folder.data).role === 'inbox' && JSON.parse(folder.data).localStatus;
+      const syncState = !r.enabled
+        ? 'paused'
+        : !status?.uidvalidity
+          ? 'needs-sync'
+          : status.uidvalidity !== baseline?.validity
+            ? 'mailbox-reset'
+            : 'ready';
+      const { baseline: _, ...publicRule } = r;
+      return { ...publicRule, syncState };
+    }),
+  };
+}
+export function saveLocalRule(input: RuleInput, access: InboxAccess) {
+  return serial(async () => {
+    ruleAccess(input.accountId, access);
+    const existing = await storedRules(input.accountId);
+    const old = input.id && existing.find((r) => r.id === input.id);
+    if (input.id && !old) throw new Error('rule-not-found');
+    if (
+      !['sender', 'subject'].includes(input.field) ||
+      !['label', 'category'].includes(input.action)
+    )
+      throw new Error('invalid-rule');
+    const name = input.name.trim(),
+      query = input.query.trim().normalize('NFC');
+    if (!name || name.length > 80 || !query || query.length > 200)
+      throw new Error('invalid-rule-text');
+    if (input.action === 'label' && !(await localLabels()).some((l) => l.id === input.value))
+      throw new Error('label-not-found');
+    if (input.action === 'category' && !Object.hasOwnProperty.call(categories, input.value))
+      throw new Error('invalid-category');
+    const baseline = input.enabled ? JSON.stringify(await inboxBaseline(input.accountId)) : null;
+    const id = input.id || randomUUID();
+    ruleAccess(input.accountId, access);
+    await sql(
+      'INSERT INTO PaperReedLocalRule (id,accountId,name,field,query,action,value,enabled,position,baseline) VALUES (?,?,?,?,?,?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET name=excluded.name,field=excluded.field,query=excluded.query,action=excluded.action,value=excluded.value,enabled=excluded.enabled,baseline=excluded.baseline',
+      [
+        id,
+        input.accountId,
+        name,
+        input.field,
+        query,
+        input.action,
+        input.value,
+        input.enabled ? 1 : 0,
+        old ? old.position : existing.reduce((m, r) => Math.max(m, r.position), -1) + 1,
+        baseline,
+      ]
+    );
+    changed();
+    return { id };
+  });
+}
+export function deleteLocalRule(input: { accountId: string; id: string }, access: InboxAccess) {
+  return serial(async () => {
+    ruleAccess(input.accountId, access);
+    await sql('DELETE FROM PaperReedLocalRule WHERE accountId=? AND id=?', [
+      input.accountId,
+      input.id,
+    ]);
+    changed();
+    return { deleted: true };
+  });
+}
+export function reorderLocalRules(
+  input: { accountId: string; ids: string[] },
+  access: InboxAccess
+) {
+  return serial(async () => {
+    ruleAccess(input.accountId, access);
+    const rules = await storedRules(input.accountId);
+    if (
+      input.ids.length !== rules.length ||
+      new Set(input.ids).size !== rules.length ||
+      rules.some((r) => !input.ids.includes(r.id))
+    )
+      throw new Error('rule-list-changed');
+    ruleAccess(input.accountId, access);
+    writer.transaction(() =>
+      input.ids.forEach((id, i) =>
+        writer
+          .prepare('UPDATE PaperReedLocalRule SET position=? WHERE accountId=? AND id=?')
+          .run(i, input.accountId, id)
+      )
+    )();
+    changed();
+    return { reordered: true };
+  });
+}
+const isExternal = (m: Message) =>
+  m.from.length > 0 &&
+  !m.from.some((c) => AccountStore.accountForEmail(c.email)?.id === m.accountId);
+async function latestIncoming(target: MailTarget) {
+  const messages = await DatabaseStore.findAll<Message>(Message)
+    .where({ accountId: target.accountId, threadId: target.threadId, draft: false })
+    .order(Message.attributes.date.descending())
+    .order(Message.attributes.id.descending());
+  return messages.find(isExternal);
+}
+function ruleEffects(message: Message | undefined, rules: LocalRule[]) {
+  const result: { ruleIds: string[]; labelIds: string[]; category?: MailCategory } = {
+    ruleIds: [],
+    labelIds: [],
+  };
+  if (!message || !isExternal(message)) return result;
+  for (const rule of rules) {
+    if (!rule.enabled) continue;
+    const text =
+      rule.field === 'subject'
+        ? message.subject
+        : message.from.map((c) => `${c.name || ''} ${c.email || ''}`).join(' ');
+    if (!text.normalize('NFC').toLowerCase().includes(rule.query.normalize('NFC').toLowerCase()))
+      continue;
+    result.ruleIds.push(rule.id);
+    if (rule.action === 'label') result.labelIds.push(rule.value);
+    else result.category = rule.value as MailCategory;
+  }
+  result.labelIds = [...new Set(result.labelIds)];
+  return result;
+}
+function commitEffects(target: MailTarget, effects: ReturnType<typeof ruleEffects>) {
+  for (const labelId of effects.labelIds)
+    writer
+      .prepare(
+        'INSERT OR IGNORE INTO PaperReedLocalThreadLabel (accountId,threadId,labelId) SELECT ?,?,id FROM PaperReedLocalLabel WHERE id=?'
+      )
+      .run(target.accountId, target.threadId, labelId);
+  if (effects.category)
+    writer
+      .prepare(
+        'INSERT INTO PaperReedLocalThread (accountId,threadId,category) VALUES (?,?,?) ON CONFLICT(accountId,threadId) DO UPDATE SET category=CASE WHEN categoryManual=0 THEN excluded.category ELSE category END'
+      )
+      .run(target.accountId, target.threadId, effects.category);
+}
+export async function previewLocalRules(
+  input: { accountId: string; targets: MailTarget[] },
+  access: InboxAccess
+) {
+  access.check(input.accountId, false);
+  if (input.targets.length > 100) throw new Error('too-many-targets');
+  const rules = await storedRules(input.accountId),
+    items = [];
+  for (const target of input.targets) {
+    try {
+      if (target.accountId !== input.accountId) throw new Error('account-mismatch');
+      await allowed(target, access, false);
+      const message = await latestIncoming(target);
+      const effects = ruleEffects(message, rules);
+      const states = await localStates([target], access);
+      items.push({
+        ...target,
+        messageId: message?.id || null,
+        subject: message?.subject || '',
+        ...effects,
+        categoryManual: states[target.threadId].categoryManual,
+        currentCategory: states[target.threadId].category,
+        status: 'preview',
+      });
+    } catch (error) {
+      items.push({ ...target, status: 'rejected', error: error.message });
+    }
+  }
+  // If the editor changed while the preview was being read, ask for a fresh snapshot.
+  if (revisionOf(await storedRules(input.accountId)) !== revisionOf(rules))
+    throw new Error('rules-changed');
+  access.check(input.accountId, false);
+  return { revision: revisionOf(rules), items };
+}
+export function applyLocalRules(
+  input: { accountId: string; revision: string; targets: (MailTarget & { messageId: string })[] },
+  access: InboxAccess
+) {
+  return serial(async () => {
+    access.check(input.accountId, true);
+    if (!input.targets.length || input.targets.length > 100) throw new Error('invalid-targets');
+    const rules = await storedRules(input.accountId);
+    if (revisionOf(rules) !== input.revision) throw new Error('rules-changed');
+    const items = [];
+    for (const target of input.targets) {
+      try {
+        if (target.accountId !== input.accountId) throw new Error('account-mismatch');
+        await allowed(target, access, true);
+        const message = await latestIncoming(target);
+        if (!message || message.id !== target.messageId) throw new Error('preview-stale');
+        const effects = ruleEffects(message, rules);
+        await allowed(target, access, true);
+        writer.transaction(() => commitEffects(target, effects))();
+        items.push({ ...target, status: effects.ruleIds.length ? 'succeeded' : 'unchanged' });
+      } catch (error) {
+        items.push({ ...target, status: 'rejected', error: error.message });
+      }
+    }
+    changed();
+    return { items };
+  });
+}
+let autoRun: Promise<number>;
+export function processLocalRules() {
+  if (autoRun) return autoRun;
+  autoRun = serial(async () => {
+    let count = 0;
+    for (const accountId of AccountStore.accountIds()) {
+      const rules = (await storedRules(accountId)).filter((r) => r.enabled && r.baseline);
+      if (!rules.length) continue;
+      const folders = await sql('SELECT id,data FROM Folder WHERE accountId=?', [accountId]);
+      const valid = rules.filter((r) => {
+        const b = JSON.parse(r.baseline),
+          f = folders.find((f) => f.id === b.folderId);
+        return (
+          f &&
+          JSON.parse(f.data).role === 'inbox' &&
+          JSON.parse(f.data).localStatus?.uidvalidity === b.validity
+        );
+      });
+      if (!valid.length) continue;
+      const baseline = JSON.parse(valid[0].baseline);
+      const minUID = Math.min(...valid.map((r) => JSON.parse(r.baseline).nextUID));
+      // A per-message marker avoids losing lower UIDs ingested after a higher UID.
+      const candidates = await sql(
+        'SELECT DISTINCT m.id,p.remoteUID FROM Message m JOIN MessageFolder p ON p.messageId=m.id WHERE m.accountId=? AND m.draft=0 AND p.folderId=? AND p.remoteUID>=? AND NOT EXISTS (SELECT 1 FROM PaperReedRuleProcessed seen WHERE seen.accountId=m.accountId AND seen.messageId=m.id) ORDER BY p.remoteUID,m.id LIMIT 100',
+        [accountId, baseline.folderId, minUID]
+      );
+      for (const candidate of candidates) {
+        const message = await DatabaseStore.find<Message>(Message, candidate.id);
+        if (!message) continue;
+        const thread = await DatabaseStore.find<Thread>(Thread, message.threadId);
+        if (!thread) continue;
+        const usable =
+          thread.categories.some((c) => c.role === 'inbox') &&
+          !thread.categories.some((c) => ['spam', 'trash'].includes(c.role));
+        const effects = ruleEffects(
+          usable ? message : undefined,
+          valid.filter((r) => {
+            const b = JSON.parse(r.baseline);
+            return b.folderId === baseline.folderId && candidate.remoteUID >= b.nextUID;
+          })
+        );
+        writer.transaction(() => {
+          commitEffects({ accountId, threadId: message.threadId }, effects);
+          writer
+            .prepare(
+              'INSERT OR IGNORE INTO PaperReedRuleProcessed (accountId,messageId) VALUES (?,?)'
+            )
+            .run(accountId, message.id);
+        })();
+        count++;
+      }
+    }
+    if (count) changed();
+    return count;
+  }).finally(() => {
+    autoRun = undefined;
+  });
+  return autoRun;
+}
