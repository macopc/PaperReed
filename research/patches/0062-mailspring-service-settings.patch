diff --git a/app/internal_packages/preferences/lib/tabs/paper-reed-subscription.tsx b/app/internal_packages/preferences/lib/tabs/paper-reed-subscription.tsx
new file mode 100644
index 0000000..2153da4
--- /dev/null
+++ b/app/internal_packages/preferences/lib/tabs/paper-reed-subscription.tsx
@@ -0,0 +1,117 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { dialog, getCurrentWindow } from '@electron/remote';
+import { shell } from 'electron';
+import { Actions, IdentityStore, MailspringAPIRequest } from 'mailspring-exports';
+
+const planName = (plan: string) => (plan ? `Mailspring ${plan}` : '暂无套餐信息');
+
+export default function PaperReedSubscription() {
+  const [identity, setIdentity] = useState(() => IdentityStore.identity());
+  const [status, setStatus] = useState('');
+  const [pending, setPending] = useState(false);
+  const busy = useRef(false);
+  const mounted = useRef(false);
+  const effectivePlanDiffers = identity?.stripePlanEffective && identity.stripePlanEffective !== identity.stripePlan;
+
+  useEffect(() => {
+    mounted.current = true;
+    const unsubscribe = IdentityStore.listen(() => setIdentity(IdentityStore.identity()));
+    return () => {
+      mounted.current = false;
+      unsubscribe();
+    };
+  }, []);
+
+  const requireCurrentIdentity = () => {
+    const current = IdentityStore.identity();
+    if (!identity || current?.id !== identity.id || current.token !== identity.token) {
+      throw new Error('The active Mailspring identity changed.');
+    }
+  };
+
+  const run = async (action: () => Promise<void>, progress: string, error: string) => {
+    if (busy.current) return;
+    busy.current = true;
+    setPending(true);
+    setStatus(progress);
+    try {
+      await action();
+      if (mounted.current) setStatus('');
+    } catch {
+      if (mounted.current) setStatus(error);
+    } finally {
+      busy.current = false;
+      if (mounted.current) setPending(false);
+    }
+  };
+
+  const refresh = () => run(async () => {
+    requireCurrentIdentity();
+    await IdentityStore.fetchIdentity({ requireFresh: true });
+  }, '正在刷新订阅状态…', '无法刷新订阅状态。请检查连接后重试。');
+
+  const openPage = (path: string) => run(async () => {
+    requireCurrentIdentity();
+    const url = new URL(await IdentityStore.fetchSingleSignOnURL(path, { source: 'Preferences' }));
+    if (url.origin !== MailspringAPIRequest.rootURLForServer('identity')) {
+      throw new Error('Unexpected Mailspring account page');
+    }
+    if (!mounted.current) return;
+    requireCurrentIdentity();
+    await shell.openExternal(url.href);
+  }, '正在打开 Mailspring 页面…', '无法打开 Mailspring 页面，请重试。');
+
+  const signOut = () => {
+    if (busy.current) return;
+    const response = dialog.showMessageBoxSync(getCurrentWindow(), {
+      type: 'warning',
+      message: '退出 Mailspring ID？',
+      detail: 'Paper Reed 会重启，请先保存正在编辑的内容。重启后仍可使用已添加的邮箱账号。退出后，Paper Reed 内无法重新登录此 Mailspring ID。\n\n订阅和续费按原设置继续。若需调整订阅，请先打开「管理账单」。',
+      buttons: ['取消', '退出并重启'],
+      defaultId: 0,
+      cancelId: 0,
+    });
+    if (response === 1) Actions.logoutMailspringIdentity();
+  };
+
+  return (
+    <div className="pr-subscription">
+      <section className="pr-settings-group" aria-labelledby="pr-service-identity">
+        <h2 id="pr-service-identity">{identity ? 'Mailspring ID' : '未连接 Mailspring ID'}</h2>
+        {identity ? (
+          <>
+            <p className="pr-service-email">{identity.emailAddress}</p>
+            <dl>
+              <div><dt>订阅套餐</dt><dd>{planName(identity.stripePlan)}</dd></div>
+              {effectivePlanDiffers && (
+                <div><dt>当前权限</dt><dd>{planName(identity.stripePlanEffective)}</dd></div>
+              )}
+            </dl>
+            {effectivePlanDiffers && <p>功能以当前权限为准。可在「管理账单」核对付款和订阅状态。</p>}
+            <div className="pr-service-actions" aria-label="Mailspring 账号操作" role="group">
+              <button type="button" aria-disabled={pending || undefined} onClick={() => openPage('/dashboard')}>
+                管理账号
+              </button>
+              <button type="button" aria-disabled={pending || undefined} onClick={() => openPage('/dashboard#billing')}>
+                管理账单
+              </button>
+              {identity.stripePlan === 'Basic' && (
+                <button type="button" aria-disabled={pending || undefined} onClick={() => openPage('/payment')}>
+                  查看 Pro 方案
+                </button>
+              )}
+              <button type="button" aria-disabled={pending || undefined} onClick={refresh}>刷新状态</button>
+              <button type="button" aria-disabled={pending || undefined} onClick={signOut}>退出登录…</button>
+            </div>
+            <p className="pr-service-status" role="status">{status}</p>
+          </>
+        ) : (
+          <>
+            <p>收发邮件可直接连接邮箱，无需 Mailspring ID。</p>
+            <button type="button" onClick={() => Actions.switchPreferencesTab('Accounts')}>管理邮箱账号</button>
+          </>
+        )}
+      </section>
+    </div>
+  );
+}
