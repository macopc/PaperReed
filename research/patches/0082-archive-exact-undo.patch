+static vector<json> _pendingPlacementChangesAfter(MailStore * store, Task * task) {
+    SQLite::Statement query(store->db(),
+        "SELECT data FROM Task WHERE accountId = ? AND status = 'remote' "
+        "AND rowid > (SELECT rowid FROM Task WHERE id = ?) "
+        "AND json_extract(data, '$.__cls') IN ('ChangeFolderTask', 'ChangeUnreadTask', 'ChangeStarredTask') ORDER BY rowid");
+    query.bind(1, task->accountId());
+    query.bind(2, task->id());
+    vector<json> moves;
+    while (query.executeStep()) moves.push_back(json::parse(query.getColumn(0).getString()));
+    return moves;
+}
