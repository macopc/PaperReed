+    throw new Error('invalid-request');
+  const seen = new Set<string>();
+  const items: MailReceipt[] = [];
+  for (const target of input.targets) {
+    const key = JSON.stringify(target);
+    if (seen.has(key)) continue;
+    seen.add(key);
+    try {
+      access.check(target.accountId, true);
+      const id = taskId(target.accountId, input.requestId, target.threadId);
+      const existing = await DatabaseStore.find<ChangeMailTask>(Task, id);
+      if (existing) {
+        if (existing.paperReed?.action !== input.action) throw new Error('request-conflict');
+        items.push(receipt(await taskFor(target.accountId, id, access, true)));
+        pending.delete(id + ':' + input.action);
+        continue;
+      }
+      const pendingKey = id + ':' + input.action;
+      if ([...pending.keys()].some((k) => k.startsWith(id + ':') && k !== pendingKey))
+        throw new Error('request-conflict');
+      if (!pending.has(pendingKey))
+        pending.set(
+          pendingKey,
+          (async () => {
+            const thread = await DatabaseStore.find<Thread>(Thread, target.threadId);
+            if (
+              !thread ||
+              thread.accountId !== target.accountId ||
+              !isThreadAllowed(access.grant(), thread)
+            )
