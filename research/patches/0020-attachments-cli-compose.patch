diff --git a/app/src/services/mail-core/draft-files.ts b/app/src/services/mail-core/draft-files.ts
new file mode 100644
index 0000000..6b2ed9d
--- /dev/null
+++ b/app/src/services/mail-core/draft-files.ts
@@ -0,0 +1,53 @@
+import fs from 'fs';
+import path from 'path';
+import { File } from '../../flux/models/file';
+import { generateTempId } from '../../flux/models/utils';
+import AttachmentStore from '../../flux/stores/attachment-store';
+
+export const MAX_DRAFT_ATTACHMENT_BYTES = 25 * 1000000;
+
+export function checkAttachmentSize(files: File[]) {
+  if (files.reduce((total, file) => total + file.size, 0) > MAX_DRAFT_ATTACHMENT_BYTES)
+    throw new Error('attachments-too-large: Attachments must total at most 25MB.');
+}
+
+// Every import owns its bytes. A recovery copy and a send snapshot must never
+// share a removable draft attachment, including inline images (preserve cid).
+export async function importDraftFile(sourcePath: string, original?: File): Promise<File> {
+  if (!path.isAbsolute(sourcePath)) throw new Error('attachment-path-must-be-absolute');
+  const stats = await fs.promises.stat(sourcePath);
+  if (!stats.isFile()) throw new Error('attachment-not-a-file');
+  if (stats.size > MAX_DRAFT_ATTACHMENT_BYTES) throw new Error('attachments-too-large');
+  const file = original ? original.clone() : new File({ filename: path.basename(sourcePath) });
+  file.id = generateTempId();
+  file.messageId = null;
+  file.localFilename = file.safeDisplayName();
+  const target = AttachmentStore.pathForFile(file);
+  await fs.promises.mkdir(path.dirname(target), { recursive: true });
+  try {
+    await fs.promises.copyFile(sourcePath, target, fs.constants.COPYFILE_FICLONE);
+    file.size = (await fs.promises.stat(target)).size;
+    checkAttachmentSize([file]);
+    return file;
+  } catch (error) {
+    AttachmentStore.deleteFilesOwnedByDraft([file]);
+    throw error;
+  }
+}
+
+export async function copyDraftFiles(files: File[]): Promise<File[]> {
+  const copies: File[] = [];
+  try {
+    for (const file of files) {
+      const source = file.localFilename
+        ? AttachmentStore.pathForFile(file)
+        : await AttachmentStore.resolvePathForFile(file);
+      copies.push(await importDraftFile(source, file));
+    }
+    checkAttachmentSize(copies);
+    return copies;
