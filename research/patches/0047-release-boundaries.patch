 import { registerTools, registerResources } from './mcp-tools';
 
+const MAX_REQUEST_BYTES = 2 * 1024 * 1024;
+
+// New-session requests are parsed here; established sessions use the SDK's same limit.
+function readBody(req: http.IncomingMessage): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const chunks: Buffer[] = [];
+    let size = 0;
+    const cleanup = () => {
+      req.off('data', data);
+      req.off('end', end);
+      req.off('error', error);
+      req.off('aborted', aborted);
+    };
+    const error = (err: Error) => {
+      cleanup();
+      reject(err);
+    };
+    const aborted = () => error(new Error('Request aborted'));
+    const data = (chunk: Buffer) => {
+      size += chunk.length;
+      if (size > MAX_REQUEST_BYTES) {
+        error(Object.assign(new Error('Request body too large'), { statusCode: 413 }));
+        req.resume();
+      } else chunks.push(chunk);
+    };
+    const end = () => {
+      cleanup();
+      resolve(Buffer.concat(chunks).toString('utf8'));
+    };
+    req.on('data', data);
+    req.once('end', end);
+    req.once('error', error);
+    req.once('aborted', aborted);
+  });
+}
