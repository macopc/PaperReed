diff --git a/app/src/services/mail-core/local-triage.ts b/app/src/services/mail-core/local-triage.ts
new file mode 100644
index 0000000..3da3171
--- /dev/null
+++ b/app/src/services/mail-core/local-triage.ts
@@ -0,0 +1,302 @@
+import Sqlite3 from 'better-sqlite3';
+import { z } from 'zod';
+import { randomUUID } from 'crypto';
+import { AccountStore, DatabaseStore, Message, Thread } from 'mailspring-exports';
+import type { InboxAccess, MailTarget } from './inbox';
+import { isThreadAllowed } from '../mail-access/grant';
+
+export type LocalLabel = { id: string; name: string; color: string };
+export type LocalState = { pinned: boolean; snoozeUntil: number | null; labels: LocalLabel[] };
+export type LocalChange = {
+  action: 'pin' | 'unpin' | 'snooze' | 'unsnooze' | 'label-add' | 'label-remove';
+  targets: MailTarget[];
+  until?: string;
+  labelId?: string;
+};
+const listeners = new Set<() => void>();
+export function onLocalTriageChanged(fn: () => void) {
+  listeners.add(fn);
+  return () => {
+    listeners.delete(fn);
+  };
+}
+function changed() {
+  listeners.forEach((fn) => fn());
+}
+// The upstream renderer connection is read-only. One local writer uses the same database,
+// and writes only our three local tables; mail mutations stay with the native engine.
+let writer: Sqlite3.Database;
+const sql = async (query: string, values: any[] = []): Promise<any[]> => {
+  const statement = writer.prepare(query);
+  return statement.reader ? statement.all(values) : (statement.run(values), []);
+};
+let ready: Promise<void>;
+export function ensureLocalTriage() {
+  if (!ready)
+    ready = (async () => {
+      await DatabaseStore._query('SELECT 1');
+      if (!AppEnv.isMainWindow()) throw new Error('local-triage-requires-main-window');
+      writer = new Sqlite3(DatabaseStore._databasePath, { fileMustExist: true, timeout: 10000 });
+      await sql(
+        'CREATE TABLE IF NOT EXISTS PaperReedLocalThread (accountId TEXT NOT NULL, threadId TEXT NOT NULL, pinned INTEGER NOT NULL DEFAULT 0, snoozeUntil INTEGER, baseline TEXT, PRIMARY KEY(accountId, threadId))'
+      );
+      await sql(
+        'CREATE TABLE IF NOT EXISTS PaperReedLocalLabel (id TEXT PRIMARY KEY, name TEXT NOT NULL, nameKey TEXT NOT NULL UNIQUE, color TEXT NOT NULL)'
+      );
+      await sql(
+        'CREATE TABLE IF NOT EXISTS PaperReedLocalThreadLabel (accountId TEXT NOT NULL, threadId TEXT NOT NULL, labelId TEXT NOT NULL, PRIMARY KEY(accountId, threadId, labelId))'
+      );
+    })().catch((error) => {
+      writer?.close();
+      writer = undefined;
+      ready = undefined;
+      throw error;
+    });
+  return ready;
+}
+let writes: Promise<unknown> = Promise.resolve();
+function serial<T>(fn: () => Promise<T>): Promise<T> {
+  const result = writes.then(async () => {
+    await ensureLocalTriage();
+    return fn();
+  });
+  writes = result.catch(() => {});
+  return result;
+}
+async function allowed(ref: MailTarget, access: InboxAccess, write: boolean) {
+  access.check(ref.accountId, write);
+  const thread = await DatabaseStore.find<Thread>(Thread, ref.threadId);
+  access.check(ref.accountId, write);
+  if (!thread || thread.accountId !== ref.accountId || !isThreadAllowed(access.grant(), thread))
+    throw new Error('thread-not-found');
+  return thread;
+}
+export async function localLabels(): Promise<LocalLabel[]> {
+  await ensureLocalTriage();
+  return sql('SELECT id, name, color FROM PaperReedLocalLabel ORDER BY nameKey');
+}
+function globalLabelAccess(access: InboxAccess) {
+  const ids = AccountStore.accountIds();
+  if (!ids.length) throw new Error('account-not-found');
+  ids.forEach((id) => access.check(id, true));
+  if (Object.values(access.grant().excludedFolderIds).some((ids) => ids.length))
+    throw new Error('Access denied: global labels require all mailbox access');
+}
+export function editLocalLabel(
+  input: { id?: string; name?: string; color?: string; remove?: boolean },
+  access: InboxAccess
+) {
+  return serial(async () => {
+    globalLabelAccess(access);
+    const labels = await localLabels();
+    const old = input.id && labels.find((l) => l.id === input.id);
+    if (input.id && !old) throw new Error('label-not-found');
+    if (input.remove) {
+      if (!old) throw new Error('label-not-found');
+      globalLabelAccess(access);
+      writer.transaction(() => {
+        writer.prepare('DELETE FROM PaperReedLocalLabel WHERE id = ?').run(input.id);
+        writer.prepare('DELETE FROM PaperReedLocalThreadLabel WHERE labelId = ?').run(input.id);
+      })();
+      changed();
+      return { id: input.id, deleted: true };
+    }
+    const name = (input.name ?? (old ? old.name : '')).trim().normalize('NFC');
+    const color = input.color ?? (old ? old.color : '#688177');
+    if (!name || name.length > 40 || /[\u0000-\u001f\u007f]/.test(name))
+      throw new Error('invalid-label-name');
+    if (!/^#[a-fA-F0-9]{6}$/.test(color)) throw new Error('invalid-label-color');
+    if (labels.some((l) => l.id !== input.id && l.name.toLowerCase() === name.toLowerCase()))
+      throw new Error('duplicate-label-name');
+    const id = input.id || randomUUID();
+    globalLabelAccess(access);
+    await sql(
+      'INSERT INTO PaperReedLocalLabel (id,name,nameKey,color) VALUES (?,?,?,?) ON CONFLICT(id) DO UPDATE SET name=excluded.name,nameKey=excluded.nameKey,color=excluded.color',
+      [id, name, name.toLowerCase(), color]
+    );
+    changed();
+    return { id, name, color };
+  });
+}
+export async function localStates(
+  targets: MailTarget[],
+  access: InboxAccess
+): Promise<Record<string, LocalState>> {
+  await ensureLocalTriage();
+  const result: Record<string, LocalState> = {};
+  for (const target of targets) {
+    await allowed(target, access, false);
+    const [state] = await sql(
+      'SELECT pinned,snoozeUntil FROM PaperReedLocalThread WHERE accountId=? AND threadId=?',
+      [target.accountId, target.threadId]
+    );
+    const labels = await sql(
+      'SELECT l.id,l.name,l.color FROM PaperReedLocalLabel l JOIN PaperReedLocalThreadLabel t ON t.labelId=l.id WHERE t.accountId=? AND t.threadId=? ORDER BY l.nameKey',
+      [target.accountId, target.threadId]
+    );
+    await allowed(target, access, false);
+    result[target.threadId] = {
+      pinned: !!state?.pinned,
+      snoozeUntil: state?.snoozeUntil || null,
+      labels,
+    };
+  }
+  return result;
+}
+async function inboxBaseline(accountId: string) {
+  const rows = await sql(
+    "SELECT id,data FROM Folder WHERE accountId=? AND json_extract(data,'$.role')='inbox'",
+    [accountId]
+  );
+  const folder = rows[0];
+  const status = folder && JSON.parse(folder.data).localStatus;
+  if (!status?.uidvalidity || !status?.uidnext) throw new Error('snooze-needs-synced-inbox');
+  const [max] = await sql(
+    'SELECT MAX(remoteUID) AS uid FROM MessageFolder WHERE accountId=? AND folderId=?',
+    [accountId, folder.id]
+  );
+  return {
+    folderId: folder.id,
+    validity: status.uidvalidity,
+    nextUID: Math.max(status.uidnext, (max?.uid || 0) + 1),
+  };
+}
+export function changeLocalMail(input: LocalChange, access: InboxAccess) {
+  return serial(async () => {
+    if (!input.targets.length || input.targets.length > 100) throw new Error('invalid-targets');
+    if (!['pin', 'unpin', 'snooze', 'unsnooze', 'label-add', 'label-remove'].includes(input.action))
+      throw new Error('invalid-action');
+    const until = input.until ? Date.parse(input.until) : NaN;
+    if (
+      input.action === 'snooze' &&
+      (!z.string().datetime({ offset: true }).safeParse(input.until).success ||
+        !Number.isFinite(until) ||
+        until <= Date.now())
+    )
+      throw new Error('invalid-snooze-time');
+    const items = [];
+    for (const target of input.targets) {
+      try {
+        const thread = await allowed(target, access, true);
+        let baseline: string = null;
+        if (input.action === 'snooze') {
+          if (
+            !thread.categories.some((c) => c.role === 'inbox') ||
+            thread.categories.some((c) => ['spam', 'trash'].includes(c.role))
+          )
+            throw new Error('snooze-requires-inbox');
+          const cursor = await inboxBaseline(target.accountId);
+          const known = await DatabaseStore.findAll<Message>(Message).where({
+            accountId: target.accountId,
+            threadId: target.threadId,
+            draft: false,
+          });
+          baseline = JSON.stringify({ ...cursor, knownIds: known.map((m) => m.id) });
+        }
+        if (
+          input.action.startsWith('label-') &&
+          !(await localLabels()).some((l) => l.id === input.labelId)
+        )
+          throw new Error('label-not-found');
+        await allowed(target, access, true);
+        const args = [target.accountId, target.threadId];
+        if (input.action === 'pin' || input.action === 'unpin')
+          await sql(
+            'INSERT INTO PaperReedLocalThread (accountId,threadId,pinned) VALUES (?,?,?) ON CONFLICT(accountId,threadId) DO UPDATE SET pinned=excluded.pinned',
+            [...args, input.action === 'pin' ? 1 : 0]
+          );
+        else if (input.action === 'snooze' || input.action === 'unsnooze')
+          await sql(
+            'INSERT INTO PaperReedLocalThread (accountId,threadId,snoozeUntil,baseline) VALUES (?,?,?,?) ON CONFLICT(accountId,threadId) DO UPDATE SET snoozeUntil=excluded.snoozeUntil,baseline=excluded.baseline',
+            [...args, input.action === 'snooze' ? until : null, baseline]
+          );
+        else if (input.action === 'label-add')
+          await sql(
+            'INSERT OR IGNORE INTO PaperReedLocalThreadLabel (accountId,threadId,labelId) VALUES (?,?,?)',
+            [...args, input.labelId]
+          );
+        else
+          await sql(
+            'DELETE FROM PaperReedLocalThreadLabel WHERE accountId=? AND threadId=? AND labelId=?',
+            [...args, input.labelId]
+          );
+        items.push({ ...target, status: 'succeeded' });
+      } catch (error) {
+        items.push({ ...target, status: 'rejected', error: error.message });
+      }
+    }
+    changed();
+    return { items };
+  });
+}
+// UID baseline rejects historical backfill even when its Date header is newer. No remote move.
+export function reconcileLocalSnoozes() {
+  return serial(async () => {
+    const rows = await sql(
+      'SELECT accountId,threadId,snoozeUntil,baseline FROM PaperReedLocalThread WHERE snoozeUntil IS NOT NULL'
+    );
+    let count = 0;
+    for (const row of rows) {
+      if (!AccountStore.accountForId(row.accountId)) continue;
+      let wake = row.snoozeUntil <= Date.now();
+      const thread = await DatabaseStore.find<Thread>(Thread, row.threadId);
+      if (!thread) continue;
+      if (
+        thread.categories.some((c) => ['spam', 'trash'].includes(c.role)) ||
+        !thread.categories.some((c) => c.role === 'inbox')
+      )
+        wake = true;
+      if (!wake) {
+        const baseline = JSON.parse(row.baseline);
+        const [folder] = await sql('SELECT data FROM Folder WHERE id=? AND accountId=?', [
+          baseline.folderId,
+          row.accountId,
+        ]);
+        const status = folder && JSON.parse(folder.data).localStatus;
+        // A UIDVALIDITY reset invalidates new-mail evidence; retain the timer, never guess.
+        if (status?.uidvalidity === baseline.validity) {
+          const candidates = await sql(
+            'SELECT m.id FROM Message m JOIN MessageFolder p ON p.messageId=m.id WHERE m.accountId=? AND m.threadId=? AND m.draft=0 AND p.folderId=? AND p.remoteUID>=?',
+            [row.accountId, row.threadId, baseline.folderId, baseline.nextUID]
+          );
+          for (const c of candidates) {
+            if (baseline.knownIds.includes(c.id)) continue;
+            const message = await DatabaseStore.find<Message>(Message, c.id);
+            if (message?.from.length && !message.isFromMe()) {
+              wake = true;
+              break;
+            }
+          }
+        }
+      }
+      if (wake) {
+        await sql(
+          'UPDATE PaperReedLocalThread SET snoozeUntil=NULL,baseline=NULL WHERE accountId=? AND threadId=?',
+          [row.accountId, row.threadId]
+        );
+        count++;
+      }
+    }
+    if (count) changed();
+    return count;
+  });
+}
+// Only fixed SQL and escaped label IDs enter the query builder; filters run before pagination.
+export function localViewSQL(view?: string, hideSnoozed = false) {
+  const state = 's.accountId=Thread.accountId AND s.threadId=Thread.id';
+  if (view === 'pinned')
+    return `EXISTS (SELECT 1 FROM PaperReedLocalThread s WHERE ${state} AND s.pinned=1)`;
+  if (view === 'snoozed')
+    return `EXISTS (SELECT 1 FROM PaperReedLocalThread s WHERE ${state} AND s.snoozeUntil IS NOT NULL)`;
+  if (view?.startsWith('label:'))
+    return `EXISTS (SELECT 1 FROM PaperReedLocalThreadLabel t JOIN PaperReedLocalLabel l ON l.id=t.labelId WHERE t.accountId=Thread.accountId AND t.threadId=Thread.id AND l.id='${view.slice(6).replace(/'/g, "''")}')`;
+  return hideSnoozed
+    ? `NOT EXISTS (SELECT 1 FROM PaperReedLocalThread s WHERE ${state} AND s.snoozeUntil IS NOT NULL)`
+    : '1';
+}
+export const localPinOrder = {
+  attr: Thread.attributes.lastMessageReceivedTimestamp,
+  attribute: () => Thread.attributes.lastMessageReceivedTimestamp,
+  orderBySQL: () =>
+    'COALESCE((SELECT pinned FROM PaperReedLocalThread s WHERE s.accountId=Thread.accountId AND s.threadId=Thread.id),0) DESC',
+};
