diff --git a/app/src/components/toolbar-window-controls.tsx b/app/src/components/toolbar-window-controls.tsx
new file mode 100644
index 0000000..46ff1e6
--- /dev/null
+++ b/app/src/components/toolbar-window-controls.tsx
@@ -0,0 +1,85 @@
+import React from 'react';
+import { localized } from 'mailspring-exports';
+import { RovingTabIndexToolbar } from './roving-tab-index-toolbar';
+
+interface ToolbarWindowControlsProps {
+  closeDisabled?: boolean;
+  closeLabel?: string;
+  onClose?: () => void;
+  maximizeDisabled?: boolean;
+}
+
+export class ToolbarWindowControls extends React.Component<ToolbarWindowControlsProps, { alt: boolean }> {
+  static displayName = 'ToolbarWindowControls';
+
+  constructor(props) {
+    super(props);
+    this.state = { alt: AppEnv.keymaps.getIsAltKeyDown() };
+  }
+
+  componentDidMount() {
+    if (process.platform === 'darwin') {
+      document.addEventListener(AppEnv.keymaps.EVENT_ALT_KEY_STATE_CHANGE, this._onAlt);
+    }
+  }
+
+  componentWillUnmount() {
+    if (process.platform === 'darwin') {
+      document.removeEventListener(AppEnv.keymaps.EVENT_ALT_KEY_STATE_CHANGE, this._onAlt);
+    }
+  }
+
+  _onAlt = () => {
+    this.setState({ alt: AppEnv.keymaps.getIsAltKeyDown() });
+  };
+
+  _onMaximize = (event: React.MouseEvent<HTMLButtonElement>) => {
+    if (process.platform === 'darwin' && !event.altKey) {
+      AppEnv.setFullScreen(!AppEnv.isFullScreen());
+    } else {
+      AppEnv.maximize();
+    }
+  };
+
+  render() {
+    const enabled =
+      process.platform === 'darwin' ||
+      (process.platform === 'linux' &&
+        AppEnv.config.get('core.workspace.menubarStyle') === 'hamburger');
+
+    if (!enabled) {
+      return <span />;
+    }
+
+    return (
+      <RovingTabIndexToolbar
+        label={localized('Window Controls')}
+        className={`toolbar-window-controls alt-${this.state.alt}`}
+      >
+        <button
+          type="button"
+          tabIndex={-1}
+          className="close"
+          aria-label={this.props.closeLabel ?? localized('Close window')}
+          disabled={this.props.closeDisabled}
+          onClick={this.props.onClose ?? (() => AppEnv.close())}
+        />
+        <button
+          type="button"
+          tabIndex={-1}
+          className="minimize"
+          aria-label={localized('Minimize window')}
+          onClick={() => AppEnv.minimize()}
+        />
+        <button
+          type="button"
+          tabIndex={-1}
+          className="maximize"
+          aria-label={localized('Maximize window')}
+          disabled={this.props.maximizeDisabled}
+          onClick={this._onMaximize}
+        />
+      </RovingTabIndexToolbar>
+    );
+  }
+}
