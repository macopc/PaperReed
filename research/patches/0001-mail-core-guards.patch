diff --git a/MailSync/MailMutationGuard.hpp b/MailSync/MailMutationGuard.hpp
new file mode 100644
index 0000000..77ae9ca
--- /dev/null
+++ b/MailSync/MailMutationGuard.hpp
@@ -0,0 +1,105 @@
+#pragma once
+
+#include <SQLiteCpp/SQLiteCpp.h>
+#include "json.hpp"
+#include <stdexcept>
+#include <string>
+
+// Paper Reed experiment. Uses the engine database and caller's write transaction;
+// it does not own a queue, connection, or network retry policy.
+namespace PaperReed {
+using nlohmann::json;
+
+struct Conflict : std::runtime_error {
+    std::string key;
+    Conflict(const std::string & key, const std::string & detail)
+        : std::runtime_error(detail), key(key) {}
+};
+
+class MailMutationGuard {
+    SQLite::Database & db;
+public:
+    explicit MailMutationGuard(SQLite::Database & db) : db(db) {}
+
+    static void migrate(SQLite::Database & db) {
+        db.exec("CREATE TABLE IF NOT EXISTS PaperReedSend ("
+                "accountId TEXT NOT NULL, requestId TEXT NOT NULL, draftId TEXT NOT NULL, "
+                "payload TEXT NOT NULL, phase TEXT NOT NULL, sentCopy TEXT NOT NULL DEFAULT 'pending', "
+                "PRIMARY KEY (accountId, requestId))");
+        db.exec("CREATE UNIQUE INDEX IF NOT EXISTS PaperReedSendActiveDraft "
+                "ON PaperReedSend(accountId, draftId) WHERE phase != 'rejected'");
+    }
+
+    json request(const std::string & account, const std::string & id) {
+        SQLite::Statement q(db, "SELECT draftId, payload, phase, sentCopy FROM PaperReedSend "
+                                "WHERE accountId = ? AND requestId = ?");
+        q.bind(1, account); q.bind(2, id);
+        if (!q.executeStep()) return nullptr;
+        return {{"draftId", q.getColumn(0).getString()}, {"payload", q.getColumn(1).getString()},
+                {"phase", q.getColumn(2).getString()}, {"sentCopy", q.getColumn(3).getString()}};
+    }
+
+    void requireEditable(const std::string & account, const std::string & header) {
+        SQLite::Statement q(db, "SELECT requestId FROM PaperReedSend "
+                                "WHERE accountId = ? AND draftId = ? AND phase != 'rejected'");
+        q.bind(1, account); q.bind(2, header);
+        if (q.executeStep()) throw Conflict("draft-frozen", q.getColumn(0).getString());
+    }
+
+    // Resolve by account + Message-ID, so omitting/changing the local id cannot
+    // turn a stale update into an insert. Return the authoritative local id.
+    std::string checkRevision(const std::string & account, const json & draft, bool requireExisting) {
+        if (draft.value("aid", std::string()) != account ||
+            !draft.count("hMsgId") || !draft["hMsgId"].is_string() ||
+            draft["hMsgId"].get<std::string>().empty() ||
+            !draft.count("v") || !draft["v"].is_number_integer()) {
+            throw Conflict("invalid-draft", "Account, Message-ID and revision are required.");
+        }
+        auto header = draft["hMsgId"].get<std::string>();
+        SQLite::Statement q(db, "SELECT id, data FROM Message WHERE accountId = ? AND headerMessageId = ?");
+        q.bind(1, account); q.bind(2, header);
+        if (!q.executeStep()) {
+            if (requireExisting || draft["v"].get<int>() != 0)
+                throw Conflict("draft-conflict", "The draft no longer exists.");
+            return "";
+        }
+        auto id = q.getColumn(0).getString();
+        auto current = json::parse(q.getColumn(1).getString());
+        if (!current.value("draft", false) || current["v"] != draft["v"] ||
+            (draft.count("id") && draft["id"] != id)) {
+            throw Conflict("draft-conflict", "Read the latest draft before saving or sending.");
+        }
+        return id;
+    }
+
+    // Call inside the same transaction as saving the remote-ready Task. A
+    // rejected preflight releases only the draft lock, never request history.
+    void admit(const std::string & account, const std::string & id, const json & draft, const json & payload) {
+        auto prior = request(account, id);
+        if (!prior.is_null()) {
+            throw Conflict(prior["payload"] == payload.dump() ? "duplicate-send" : "request-conflict", id);
+        }
+        checkRevision(account, draft, true);
+        auto header = draft["hMsgId"].get<std::string>();
+        requireEditable(account, header);
+        SQLite::Statement q(db, "INSERT INTO PaperReedSend(accountId, requestId, draftId, payload, phase) "
+                                "VALUES (?, ?, ?, ?, 'queued')");
+        q.bind(1, account); q.bind(2, id); q.bind(3, header); q.bind(4, payload.dump()); q.exec();
+    }
+
+    void transition(const std::string & account, const std::string & id,
+                    const std::string & from, const std::string & to) {
+        SQLite::Statement q(db, "UPDATE PaperReedSend SET phase = ? "
+                                "WHERE accountId = ? AND requestId = ? AND phase = ?");
+        q.bind(1, to); q.bind(2, account); q.bind(3, id); q.bind(4, from);
+        if (q.exec() != 1) throw Conflict("send-state-conflict", "Send phase changed; do not retry delivery.");
+    }
+
+    void setCopy(const std::string & account, const std::string & id, const std::string & state) {
+        SQLite::Statement q(db, "UPDATE PaperReedSend SET sentCopy = ? "
+                                "WHERE accountId = ? AND requestId = ? AND phase = 'accepted'");
+        q.bind(1, state); q.bind(2, account); q.bind(3, id);
+        if (q.exec() != 1) throw Conflict("send-state-conflict", "Delivery acceptance is not recorded.");
+    }
+};
+}
