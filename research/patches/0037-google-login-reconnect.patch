diff --git a/app/internal_packages/onboarding/lib/paper-reed-google-page.tsx b/app/internal_packages/onboarding/lib/paper-reed-google-page.tsx
new file mode 100644
index 0000000..b6d062a
--- /dev/null
+++ b/app/internal_packages/onboarding/lib/paper-reed-google-page.tsx
@@ -0,0 +1,51 @@
+import React from 'react';
+import { Account, AccountStore } from 'mailspring-exports';
+import * as OnboardingActions from './onboarding-actions';
+import { authorizeGoogle } from './paper-reed-google-auth';
+import { buildPaperReedGmailAccount } from './onboarding-helpers';
+
+export default class PaperReedGooglePage extends React.Component<{ account: Account }> {
+  state = { busy: false, error: '' };
+  authorization?: AbortController;
+
+  componentWillUnmount() {
+    this.authorization?.abort();
+  }
+
+  connect = async () => {
+    const controller = new AbortController();
+    this.authorization = controller;
+    this.setState({ busy: true, error: '' });
+    try {
+      const authorization = await authorizeGoogle(this.props.account.emailAddress, controller.signal);
+      const existing = AccountStore.accounts().find(a =>
+        a.emailAddress.toLowerCase() === authorization.emailAddress.toLowerCase()
+      );
+      const account = await buildPaperReedGmailAccount(authorization, existing);
+      controller.signal.throwIfAborted();
+      OnboardingActions.finishAndAddAccount(account);
+    } catch (error) {
+      if (!controller.signal.aborted) this.setState({ error: error.message });
+    } finally {
+      if (!controller.signal.aborted) this.setState({ busy: false });
+    }
+  };
+
+  render() {
+    return <div className="page account-setup">
+      <div className="pr-onboarding-brand">Paper Reed<span>让邮件回归从容</span></div>
+      <h2>{this.props.account.emailAddress ? '重新连接 Google 邮箱' : '连接 Google 邮箱'}</h2>
+      <p className="message">{this.props.account.emailAddress || 'Gmail 和 Google Workspace'}<br />
+        在浏览器中登录 Google，一次授权即可收发邮件。</p>
+      {this.state.error && <p className="message error" role="alert">{this.state.error}</p>}
+      <div className="pr-onboarding-actions">
+        <button className="btn btn-large" onClick={() => OnboardingActions.moveToPreviousPage()}>返回邮箱选择</button>
+        {' '}
+        <button className="btn btn-large btn-add-account" data-google-connect disabled={this.state.busy} onClick={this.connect}>
+          {this.state.busy ? '正在授权并连接…' : '使用 Google 登录'}
+        </button>
+      </div>
+      <p className="pr-onboarding-note">凭据加密保存在本机</p>
+    </div>;
+  }
+}
