diff --git a/app/internal_packages/paper-reed/lib/rules-settings.tsx b/app/internal_packages/paper-reed/lib/rules-settings.tsx
new file mode 100644
index 0000000..1cca202
--- /dev/null
+++ b/app/internal_packages/paper-reed/lib/rules-settings.tsx
@@ -0,0 +1,478 @@
+import React, { useState, useEffect, useRef } from 'react';
+import { AccountStore } from 'mailspring-exports';
+import {
+  listLocalRules,
+  saveLocalRule,
+  deleteLocalRule,
+  reorderLocalRules,
+  previewLocalRules,
+  applyLocalRules,
+  localLabels,
+  onLocalTriageChanged,
+  categories,
+  LocalRule,
+  LocalLabel,
+  RuleInput,
+} from '../../../src/services/mail-core/local-triage';
+import { queryInbox, inboxDesktopAccess } from '../../../src/services/mail-core/inbox';
+import { triageError } from './triage-controls';
+const explain = (message: string) =>
+  ({
+    'invalid-rule-text': '请填写名称和匹配关键词。',
+    'rules-changed': '规则已变化，请重新预览。',
+    'preview-stale': '邮件已有新回复，请重新预览。',
+    'rule-not-found': '规则已被删除，请重新选择。',
+    'rule-list-changed': '规则列表已变化，请刷新后重试。',
+  })[message] || triageError(message);
+const blank = (accountId: string): RuleInput => ({
+  accountId,
+  name: '新规则',
+  field: 'subject',
+  query: '',
+  action: 'category',
+  value: 'notifications',
+  enabled: false,
+});
+const editable = (r: LocalRule): RuleInput => ({
+  accountId: r.accountId,
+  id: r.id,
+  name: r.name,
+  field: r.field,
+  query: r.query,
+  action: r.action,
+  value: r.value,
+  enabled: r.enabled,
+});
+function RulesForAccount({
+  accountId,
+  onDirty,
+}: {
+  accountId: string;
+  onDirty: (dirty: boolean) => void;
+}) {
+  const [rules, setRules] = useState<LocalRule[]>([]),
+    [labels, setLabels] = useState<LocalLabel[]>([]);
+  const [draft, setDraft] = useState<RuleInput>(blank(accountId)),
+    [saved, setSaved] = useState(JSON.stringify(blank(accountId)));
+  const [busy, setBusy] = useState(false),
+    [notice, setNotice] = useState(''),
+    [deleting, setDeleting] = useState(false);
+  const [search, setSearch] = useState('in:inbox'),
+    [preview, setPreview] = useState<Awaited<ReturnType<typeof previewLocalRules>>>(null),
+    [checked, setChecked] = useState<string[]>([]);
+  const mounted = useRef(false),
+    initialized = useRef(false);
+  const dirty = JSON.stringify(draft) !== saved;
+  const editing = useRef({ draft, saved });
+  editing.current = { draft, saved };
+  useEffect(() => {
+    onDirty(dirty);
+    const guard = (event: MouseEvent) => {
+      if (dirty && (event.target as HTMLElement).closest('.pr-preferences-nav button')) {
+        event.preventDefault();
+        event.stopImmediatePropagation();
+        setNotice('请先保存规则或放弃修改，再切换页面。');
+      }
+    };
+    document.addEventListener('click', guard, true);
+    return () => {
+      document.removeEventListener('click', guard, true);
+      onDirty(false);
+    };
+  }, [dirty]);
+
+  const choose = (r?: LocalRule) => {
+    const d = r ? editable(r) : blank(accountId);
+    setDraft(d);
+    setSaved(JSON.stringify(d));
+    setDeleting(false);
+    setNotice('');
+  };
+  const refresh = async () => {
+    try {
+      const [r, l] = await Promise.all([
+        listLocalRules(accountId, inboxDesktopAccess),
+        localLabels(),
+      ]);
+      if (!mounted.current) return;
+      setRules(r.rules as LocalRule[]);
+      setLabels(l);
+      if (!initialized.current) {
+        initialized.current = true;
+        choose(r.rules[0] as LocalRule);
+      } else if (
+        editing.current.draft.id &&
+        JSON.stringify(editing.current.draft) === editing.current.saved
+      ) {
+        const updated = r.rules.find((rule) => rule.id === editing.current.draft.id) as LocalRule;
+        if (!updated) choose(r.rules[0] as LocalRule);
+        else if (JSON.stringify(editable(updated)) !== editing.current.saved) choose(updated);
+      }
+    } catch (e) {
+      if (mounted.current) setNotice(explain(e.message));
+    }
+  };
+  useEffect(() => {
+    mounted.current = true;
+    refresh();
+    const off = onLocalTriageChanged(refresh);
+    return () => {
+      mounted.current = false;
+      off();
+    };
+  }, [accountId]);
+  const work = async (fn: () => Promise<void>) => {
+    setBusy(true);
+    setNotice('');
+    try {
+      await fn();
+    } catch (e) {
+      setNotice(explain(e.message));
+    } finally {
+      if (mounted.current) setBusy(false);
+    }
+  };
+  const save = () =>
+    work(async () => {
+      const { id } = await saveLocalRule(draft, inboxDesktopAccess);
+      const next = await listLocalRules(accountId, inboxDesktopAccess);
+      setRules(next.rules as LocalRule[]);
+      choose(next.rules.find((r) => r.id === id) as LocalRule);
+      setPreview(null);
+      setNotice('已保存；已有邮件未改动。');
+    });
+  const reorder = (delta: number) =>
+    work(async () => {
+      const ids = rules.map((r) => r.id),
+        index = ids.indexOf(draft.id);
+      [ids[index], ids[index + delta]] = [ids[index + delta], ids[index]];
+      await reorderLocalRules({ accountId, ids }, inboxDesktopAccess);
+      setPreview(null);
+    });
+  const loadPreview = () =>
+    work(async () => {
+      const threads = await queryInbox(
+        { accountIds: [accountId], query: search || 'in:inbox', limit: 51 },
+        inboxDesktopAccess
+      );
+      const result = await previewLocalRules(
+        { accountId, targets: threads.slice(0, 50).map((t) => ({ accountId, threadId: t.id })) },
+        inboxDesktopAccess
+      );
+      setPreview(result);
+      setChecked([]);
+      if (threads.length > 50) setNotice('仅预览前 50 个会话，请收窄搜索后再处理更多邮件。');
+    });
+  const apply = () =>
+    work(async () => {
+      const targets = preview.items
+        .filter((i) => checked.includes(i.threadId) && i.messageId)
+        .map((i) => ({ accountId, threadId: i.threadId, messageId: i.messageId }));
+      const result = await applyLocalRules(
+        { accountId, revision: preview.revision, targets },
+        inboxDesktopAccess
+      );
+      const failed = result.items.filter((i) => i.status === 'rejected');
+      setNotice(
+        `${result.items.length - failed.length} / ${result.items.length} 完成${failed.length ? ' · ' + explain(failed[0].error) : ' · 手动指定的分类已保留'}`
+      );
+      setChecked([]);
+      setPreview(null);
+    });
+  const current = rules.find((r) => r.id === draft.id),
+    index = rules.indexOf(current);
+  return (
+    <div className="pr-local-rules">
+      <div className="pr-rule-toolbar">
+        <span>{rules.filter((r) => r.enabled).length} 条启用 · 按顺序执行</span>
+        <button disabled={busy || dirty} onClick={() => choose()}>
+          新建规则
+        </button>
+      </div>
+      <p>只整理本机标签与分类。标签可以累加，分类采用最后一个匹配结果；手动指定的分类优先。</p>
+      <div className="pr-rule-layout">
+        <nav className="pr-rule-sidebar" aria-label="本机邮件规则">
+          {rules.map((r, i) => (
+            <button
+              key={r.id}
+              data-local-rule={r.id}
+              aria-current={draft.id === r.id ? 'page' : undefined}
+              disabled={busy || dirty}
+              onClick={() => choose(r)}
+            >
+              <span>
+                {i + 1}. {r.name}
+              </span>
+              <small>
+                {r.enabled ? (r.syncState === 'ready' ? '启用' : '等待重新同步 / 保存') : '暂停'}
+              </small>
+            </button>
+          ))}
+          {!rules.length && <p>从一个条件开始。</p>}
+        </nav>
+        <form
+          className="pr-local-rule-editor"
+          onSubmit={(e) => {
+            e.preventDefault();
+            save();
+          }}
+        >
+          <label>
+            规则名称
+            <input
+              id="pr-local-rule-name"
+              value={draft.name}
+              maxLength={80}
+              required
+              disabled={busy}
+              onChange={(e) => setDraft({ ...draft, name: e.target.value })}
+            />
+          </label>
+          <div className="pr-rule-clause">
+            <label>
+              当
+              <select
+                aria-label="匹配字段"
+                value={draft.field}
+                disabled={busy}
+                onChange={(e) =>
+                  setDraft({ ...draft, field: e.target.value as 'sender' | 'subject' })
+                }
+              >
+                <option value="sender">发件人包含</option>
+                <option value="subject">主题包含</option>
+              </select>
+            </label>
+            <label>
+              关键词
+              <input
+                aria-label="匹配关键词"
+                value={draft.query}
+                maxLength={200}
+                required
+                disabled={busy}
+                onChange={(e) => setDraft({ ...draft, query: e.target.value })}
+              />
+            </label>
+          </div>
+          <label>
+            执行
+            <select
+              aria-label="规则动作"
+              disabled={busy}
+              value={`${draft.action}:${draft.value}`}
+              onChange={(e) => {
+                const [action, ...value] = e.target.value.split(':');
+                setDraft({
+                  ...draft,
+                  action: action as 'category' | 'label',
+                  value: value.join(':'),
+                });
+              }}
+            >
+              {Object.entries(categories).map(([id, name]) => (
+                <option key={id} value={`category:${id}`}>
+                  分类为{name}
+                </option>
+              ))}
+              {labels.map((l) => (
+                <option key={l.id} value={`label:${l.id}`}>
+                  添加标签：{l.name}
+                </option>
+              ))}
+              {draft.action === 'label' && !labels.some((l) => l.id === draft.value) && (
+                <option value={`label:${draft.value}`} disabled>
+                  标签已删除，请重新选择
+                </option>
+              )}
+            </select>
+          </label>
+          <label className="pr-rule-enabled">
+            <input
+              type="checkbox"
+              checked={draft.enabled}
+              disabled={busy}
+              onChange={(e) => setDraft({ ...draft, enabled: e.target.checked })}
+            />
+            保存后启用，仅处理之后的新来信
+          </label>
+          <footer>
+            <button
+              type="submit"
+              disabled={busy || (!dirty && (!current?.enabled || current.syncState === 'ready'))}
+            >
+              保存规则
+            </button>
+            <button type="button" disabled={busy || !dirty} onClick={() => choose(current)}>
+              放弃修改
+            </button>
+            {draft.id && (
+              <>
+                <button
+                  type="button"
+                  disabled={busy || dirty || index <= 0}
+                  onClick={() => reorder(-1)}
+                >
+                  上移
+                </button>
+                <button
+                  type="button"
+                  disabled={busy || dirty || index === rules.length - 1}
+                  onClick={() => reorder(1)}
+                >
+                  下移
+                </button>
+                <button type="button" disabled={busy || dirty} onClick={() => setDeleting(true)}>
+                  删除
+                </button>
+              </>
+            )}
+          </footer>
+          {dirty && <small>有未保存的修改，请先保存或放弃。</small>}
+          {deleting && (
+            <div className="pr-rule-delete-confirm" role="alert">
+              <p>删除规则“{draft.name}”？已经添加的标签与分类会保留。</p>
+              <button type="button" onClick={() => setDeleting(false)}>
+                取消
+              </button>
